@model ApplicationUserViewModel
@{
    var isCreate = string.IsNullOrWhiteSpace(Model.Id);
    ViewData["Title"] = isCreate ? "Create User" : "Edit User";
    var formAction = isCreate ? "Create" : "Update";
}

<div class="prototype-heading">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>@(isCreate
            ? "Import an Active Directory account and set its Innovation System profile."
            : "Update the user's access period, profile, and account status.")</p>
    </div>
    <a asp-action="Index" class="prototype-button secondary">
        <i class="ti ti-arrow-left"></i>
        Back to users
    </a>
</div>

<form asp-action="@formAction" method="post" class="admin-user-form" data-loading>
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <section class="prototype-card">
        <div class="admin-form-section-heading">
            <span><i class="ti ti-id"></i></span>
            <div>
                <h2>Account details</h2>
                <p>The username must match the person's Active Directory account.</p>
            </div>
        </div>

        <div class="prototype-form-grid">
            <div>
                <label asp-for="UserName">Active Directory username *</label>
                <input asp-for="UserName" readonly="@(!isCreate)" required autocomplete="off" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Title">Account title *</label>
                <input asp-for="Title" required placeholder="e.g. Senior Banking Officer" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="EndDate">Account end date *</label>
                <input asp-for="EndDate" asp-format="{0:yyyy-MM-dd}" type="date" required />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            <div class="admin-active-toggle">
                <label asp-for="IsActive">Account status</label>
                <label class="admin-switch">
                    <input asp-for="IsActive" type="checkbox" />
                    <span aria-hidden="true"></span>
                    <strong data-active-label>@(Model.IsActive ? "Active" : "Inactive")</strong>
                </label>
            </div>
        </div>
    </section>

    <section class="prototype-card">
        <div class="admin-form-section-heading">
            <span><i class="ti ti-building-bank"></i></span>
            <div>
                <h2>Organisational profile</h2>
                <p>These details are used in idea submissions, reports, and reviewer context.</p>
            </div>
        </div>

        <div class="prototype-form-grid">
            <div>
                <label asp-for="BusinessUnit">Business unit *</label>
                <input asp-for="BusinessUnit" required placeholder="e.g. Information Technology" />
                <span asp-validation-for="BusinessUnit" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="JobTitle">Job title *</label>
                <input asp-for="JobTitle" required placeholder="e.g. Systems Analyst" />
                <span asp-validation-for="JobTitle" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Station">Duty station *</label>
                <input asp-for="Station" required placeholder="e.g. Kampala Headquarters" />
                <span asp-validation-for="Station" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="AgeBracket">Age bracket</label>
                <select asp-for="AgeBracket">
                    <option value="">Select age bracket</option>
                    <option value="18-30">18–30</option>
                    <option value="31-40">31–40</option>
                    <option value="41-50">41–50</option>
                    <option value="51+">51+</option>
                </select>
            </div>
            <div>
                <label asp-for="Gender">Gender</label>
                <select asp-for="Gender">
                    <option value="">Select gender</option>
                    <option value="Female">Female</option>
                    <option value="Male">Male</option>
                    <option value="Prefer not to say">Prefer not to say</option>
                </select>
            </div>
        </div>
    </section>

    <div class="admin-form-actions">
        <a asp-action="Index" class="prototype-button secondary">Cancel</a>
        <button type="submit" class="prototype-button">
            <i class="ti ti-@(isCreate ? "user-plus" : "device-floppy")"></i>
            @(isCreate ? "Create user" : "Save changes")
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const toggle = document.getElementById('IsActive');
            const label = document.querySelector('[data-active-label]');
            if (!toggle || !label) return;
            toggle.addEventListener('change', () => {
                label.textContent = toggle.checked ? 'Active' : 'Inactive';
            });
        })();
    </script>
}
