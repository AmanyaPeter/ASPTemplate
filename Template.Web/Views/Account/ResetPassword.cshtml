@model ApplicationUserViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="prototype-card admin-reset-card">
    <div class="admin-reset-heading">
        <div>
            <span class="admin-reset-icon"><i class="ti ti-key"></i></span>
            <h1>Reset password</h1>
            <p>Generate a temporary password for <strong>@Model.UserName</strong>.</p>
        </div>
        <a asp-action="Index" class="prototype-button secondary">
            <i class="ti ti-arrow-left"></i> Back to users
        </a>
    </div>
    <div>
        <form asp-action="ResetPassword" method="post" data-loading>
            <input type="hidden" name="userId" value="@Model.Id" />
            <div class="admin-reset-notice">
                <i class="ti ti-info-circle me-1"></i>
                A strong temporary password will be generated and shown once on the user-management page.
            </div>
            <dl class="admin-reset-user">
                <div><dt>Username</dt><dd>@Model.UserName</dd></div>
                <div><dt>Full name</dt><dd>@Model.FullName</dd></div>
                <div><dt>Email</dt><dd>@Model.Email</dd></div>
            </dl>
            <div class="admin-form-actions">
                <a asp-action="Index" class="prototype-button secondary">Cancel</a>
                <button type="submit" class="prototype-button danger" data-confirm="Reset the password for @Model.UserName?">
                    <i class="ti ti-key"></i> Reset password
                </button>
            </div>
        </form>
    </div>
</div>
