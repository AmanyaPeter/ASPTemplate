@model IEnumerable<Template.Core.Models.AuditLogs.ApplicationAuditLogViewModel>

@{
    ViewData["title"] = "Audit Logs";
    var permissions = ViewData["permissions"] as string;
}


	<div class="card">
		<div class="card-status-top bg_app_color_burgundy"></div>
		<div class="card-header d-flex justify-content-between align-items-center">
			<h3 class="card-title">Audit Logs</h3>
		</div>
		<div class="card-body">
			@* <div class="table-responsive"> *@
			<table id="logs" class="table table-hover table-striped align-middle w-100">
				<thead>
					<tr>
						<th>UserName</th>
						<th>Machine Name</th>
						<th>Message</th>
						<th>Level</th>
						<th>Timestamp</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var log in Model)
					{
						<tr>
							<td>@log.UserName</td>
							<td>@log.MachineName</td>
							<td>@log.Message</td>
							<td>@log.Level</td>
							<td>@Html.DisplayFor(modelItem => log.TimeStamp)</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
	@if (!Model.Any())
	{
		<div class="card-footer text-center text-muted">
			<i class="ti ti-mood-empty me-2"></i> No logs found
		</div>
	}
</div>
