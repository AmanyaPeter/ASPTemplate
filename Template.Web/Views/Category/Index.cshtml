@model CategoriesModel
@{
    ViewData["Title"] = "Idea Categories";
    var isEditing = Model.Category.Id != 0;
}

<div class="prototype-heading">
    <div>
        <h1>Idea categories</h1>
        <p>Maintain the classifications staff use when submitting innovation ideas.</p>
    </div>
    <a href="#category-form" class="prototype-button">
        <i class="ti ti-category-plus"></i>
        Add category
    </a>
</div>

<section class="prototype-card category-form-card" id="category-form">
    <div class="admin-form-section-heading">
        <span><i class="ti ti-@(isEditing ? "edit" : "plus")"></i></span>
        <div>
            <h2>@(isEditing ? "Edit category" : "Add a category")</h2>
            <p>@(isEditing
                ? "Update the category name, description, or availability."
                : "Create a category that can be selected on new idea submissions.")</p>
        </div>
        @if (isEditing)
        {
            <a asp-action="Index" class="prototype-button secondary">
                <i class="ti ti-x"></i>Cancel edit
            </a>
        }
    </div>

    <form asp-controller="Category" asp-action="Save" method="post" class="category-editor" data-loading>
        <input type="hidden" asp-for="Category.Id" />
        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
        <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />
        <div>
            <label asp-for="Category.Name">Category name *</label>
            <input asp-for="Category.Name" required maxlength="150" placeholder="e.g. Process Improvement" />
            <span asp-validation-for="Category.Name" class="text-danger"></span>
        </div>
        <div class="category-description-field">
            <label asp-for="Category.Description">Description</label>
            <input asp-for="Category.Description" maxlength="1000" placeholder="Describe the ideas that belong in this category" />
            <span asp-validation-for="Category.Description" class="text-danger"></span>
        </div>
        <label class="category-active-check">
            <input asp-for="Category.IsActive" type="checkbox" />
            <span>Available for new ideas</span>
        </label>
        <button type="submit" class="prototype-button">
            <i class="ti ti-device-floppy"></i>
            @(isEditing ? "Save changes" : "Create category")
        </button>
    </form>
</section>

<form asp-controller="Category" asp-action="Index" method="get" class="prototype-card category-filters">
    <label class="category-search">
        <span class="visually-hidden">Search categories</span>
        <i class="ti ti-search" aria-hidden="true"></i>
        <input asp-for="SearchTerm" type="search" placeholder="Search categories" />
    </label>
    <label>
        <span class="visually-hidden">Filter category status</span>
        <select asp-for="StatusFilter">
            <option value="">All statuses</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
    </label>
    <button type="submit" class="prototype-button"><i class="ti ti-adjustments"></i>Apply</button>
    <a asp-action="Index" class="prototype-button secondary">Clear</a>
</form>

<section class="prototype-card category-list-card">
    <div class="category-list-heading">
        <div>
            <h2>Categories</h2>
            <p>@Model.Categories.Count category record(s) on this page</p>
        </div>
    </div>

    @if (Model.Categories.Count == 0)
    {
        <div class="admin-empty-state">
            <i class="ti ti-category-off"></i>
            <h2>No categories found</h2>
            <p>Change the filters or add a new category.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td><strong>@category.Name</strong></td>
                            <td class="category-description-cell">@(string.IsNullOrWhiteSpace(category.Description) ? "No description" : category.Description)</td>
                            <td>@category.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="admin-status @(category.IsActive ? "active" : "inactive")">
                                    <i class="ti ti-@(category.IsActive ? "circle-check" : "circle-minus")"></i>
                                    @(category.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div class="category-row-actions">
                                    <a asp-action="Index"
                                       asp-route-editId="@category.Id"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-statusFilter="@Model.StatusFilter"
                                       asp-route-page="@Model.CurrentPage"
                                       class="prototype-button secondary">
                                        <i class="ti ti-edit"></i>Edit
                                    </a>
                                    @if (category.IsActive)
                                    {
                                        <form asp-action="Delete" method="post" data-loading>
                                            <input type="hidden" name="id" value="@category.Id" />
                                            <button type="submit" class="prototype-button secondary danger"
                                                    data-confirm="Remove @category.Name from active categories?">
                                                <i class="ti ti-trash"></i>Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Category pages" class="category-pagination">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <a asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-page="@pageNumber"
                   class="@(pageNumber == Model.CurrentPage ? "active" : "")"
                   aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">
                    @pageNumber
                </a>
            }
        </nav>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
