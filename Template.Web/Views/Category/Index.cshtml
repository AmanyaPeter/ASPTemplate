@model CategoriesModel
@{
    ViewData["Title"] = "Categories - Innovation Management System";
}

<div class="ims-staff-page">
    <div class="ims-staff-page-header">
        <div>
            <p class="ims-staff-page-eyebrow">Innovation Team workspace</p>
            <h1 class="ims-staff-page-title">Idea Categories</h1>
            <p class="ims-staff-page-description">Create and maintain the categories Staff use for new innovation submissions.</p>
        </div>
        <button type="button" class="ims-staff-btn ims-staff-btn-primary" onclick="openAddCategoryModal()">
            <i class="ti ti-plus"></i> Add Category
        </button>
    </div>

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="alert alert-success">@successMsg</div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="alert alert-danger">@errorMsg</div>
    }

    <form asp-controller="Category" asp-action="Index" method="get" class="ims-staff-filters-bar">
        <input type="text" class="ims-staff-form-control ims-staff-search-input" placeholder="Search categories..." asp-for="SearchTerm" />
        <select class="ims-staff-form-control" asp-for="StatusFilter">
            <option value="">All statuses</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <button class="ims-staff-btn ims-staff-btn-primary ims-staff-btn-sm" type="submit">Apply</button>
        <a asp-controller="Category" asp-action="Index" class="ims-staff-btn ims-staff-btn-secondary ims-staff-btn-sm">Clear</a>
    </form>

    <section class="ims-staff-card ims-staff-table-card">
        <div class="ims-staff-table-container table-responsive-container">
            <table class="ims-staff-data-table responsive-table">
                <thead><tr><th>Name</th><th class="description-column">Description</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead>
                <tbody>
                @if (Model.Categories.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No categories match the current filters.</td></tr>
                }
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td><strong>@category.Name</strong></td>
                        <td class="description-column">@category.Description</td>
                        <td><span class="ims-staff-badge @(category.IsActive ? "ims-category-active" : "ims-category-inactive")">@(category.IsActive ? "Active" : "Inactive")</span></td>
                        <td>@category.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="ims-staff-actions">
                                <button type="button" class="ims-staff-btn ims-staff-btn-secondary ims-staff-btn-sm"
                                        data-category-id="@category.Id"
                                        data-category-name="@category.Name"
                                        data-category-description="@category.Description"
                                        data-category-active="@category.IsActive.ToString().ToLowerInvariant()"
                                        onclick="editCategory(this)">Edit</button>
                                <form asp-controller="Category" asp-action="Delete" method="post" onsubmit="return confirm('Deactivate this category? Existing ideas will keep their category.');">
                                    <input type="hidden" name="id" value="@category.Id" />
                                    <button type="submit" class="ims-staff-btn ims-staff-btn-danger ims-staff-btn-sm">Deactivate</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="ims-staff-pagination" aria-label="Category pages">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a asp-controller="Category" asp-action="Index" asp-route-page="@pageNumber"
                       asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter"
                       class="ims-staff-pagination-link @(pageNumber == Model.CurrentPage ? "ims-staff-pagination-active" : string.Empty)">@pageNumber</a>
                }
            </nav>
        }
    </section>
</div>

<div class="ims-staff-modal-overlay" id="categoryModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="categoryModalTitle">
    <div class="ims-staff-modal">
        <div class="ims-staff-modal-header">
            <h3 id="categoryModalTitle">Add Category</h3>
            <button type="button" class="ims-staff-modal-close" onclick="closeCategoryModal()" aria-label="Close">&times;</button>
        </div>
        <form asp-controller="Category" asp-action="Save" method="post">
            <div class="ims-staff-modal-body">
                <input type="hidden" name="Category.Id" id="categoryId" value="0" />
                <div class="ims-staff-form-group">
                    <label for="categoryName">Name *</label>
                    <input type="text" name="Category.Name" id="categoryName" class="ims-staff-form-control" required maxlength="150" />
                </div>
                <div class="ims-staff-form-group">
                    <label for="categoryDescription">Description</label>
                    <textarea name="Category.Description" id="categoryDescription" class="ims-staff-form-control" maxlength="1000" rows="4"></textarea>
                </div>
                <div class="form-check form-switch">
                    <input type="checkbox" name="Category.IsActive" id="categoryIsActive" value="true" class="form-check-input" checked />
                    <input type="hidden" name="Category.IsActive" value="false" />
                    <label for="categoryIsActive" class="form-check-label">Available for new submissions</label>
                </div>
            </div>
            <div class="ims-staff-modal-footer">
                <button type="button" class="ims-staff-btn ims-staff-btn-secondary" onclick="closeCategoryModal()">Cancel</button>
                <button type="submit" class="ims-staff-btn ims-staff-btn-primary">Save Category</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const modal = document.getElementById('categoryModal');
    function openAddCategoryModal() {
        document.getElementById('categoryModalTitle').textContent = 'Add Category';
        document.getElementById('categoryId').value = '0';
        document.getElementById('categoryName').value = '';
        document.getElementById('categoryDescription').value = '';
        document.getElementById('categoryIsActive').checked = true;
        modal.style.display = 'flex';
        document.getElementById('categoryName').focus();
    }
    function editCategory(button) {
        document.getElementById('categoryModalTitle').textContent = 'Edit Category';
        document.getElementById('categoryId').value = button.dataset.categoryId;
        document.getElementById('categoryName').value = button.dataset.categoryName;
        document.getElementById('categoryDescription').value = button.dataset.categoryDescription || '';
        document.getElementById('categoryIsActive').checked = button.dataset.categoryActive === 'true';
        modal.style.display = 'flex';
        document.getElementById('categoryName').focus();
    }
    function closeCategoryModal() { modal.style.display = 'none'; }
    document.addEventListener('keydown', event => { if (event.key === 'Escape') closeCategoryModal(); });
</script>
}
