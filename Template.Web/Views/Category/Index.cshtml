@model CategoriesModel
@{
    ViewData["Title"] = "Categories - Innovation Management System";
}

<div class="ims-staff-main-wrapper">
    <main class="ims-staff-main-content ims-staff-page">
        <div class="ims-staff-page-header">
            <div>
                <p class="ims-staff-page-eyebrow">Innovation Team workspace</p>
                <h1 class="ims-staff-page-title">Idea Categories</h1>
                <p class="ims-staff-page-description">Maintain the classifications Staff select when submitting innovation ideas.</p>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <div class="ims-category-layout">
            <section class="ims-staff-card ims-category-editor">
                <div class="ims-staff-section-header">
                    <h3 id="categoryFormTitle">Add category</h3>
                </div>
                <form asp-controller="Category" asp-action="Save" method="post" id="categoryForm">
                    <input asp-for="Category.Id" type="hidden" id="categoryId" />
                    <div class="ims-staff-form-group">
                        <label asp-for="Category.Name">Category name *</label>
                        <input asp-for="Category.Name" class="ims-staff-form-control" id="categoryName" maxlength="100" required />
                    </div>
                    <div class="ims-staff-form-group">
                        <label asp-for="Category.Description">Description</label>
                        <textarea asp-for="Category.Description" class="ims-staff-form-control" id="categoryDescription" rows="4" maxlength="500"></textarea>
                    </div>
                    <div class="form-check form-switch mb-4">
                        <input asp-for="Category.IsActive" class="form-check-input" id="categoryIsActive" />
                        <label asp-for="Category.IsActive" class="form-check-label">Available for new submissions</label>
                    </div>
                    <div class="ims-staff-actions">
                        <button type="submit" class="ims-staff-btn ims-staff-btn-primary"><i class="ti ti-device-floppy"></i> Save category</button>
                        <button type="button" class="ims-staff-btn ims-staff-btn-secondary" id="cancelEditButton" hidden>Cancel edit</button>
                    </div>
                </form>
            </section>

            <div>
                <form asp-controller="Category" asp-action="Index" method="get" class="ims-staff-filters-bar">
                    <input asp-for="SearchTerm" class="ims-staff-form-control ims-staff-search-input" placeholder="Search categories..." />
                    <select asp-for="StatusFilter" class="ims-staff-form-control">
                        <option value="">All statuses</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <button type="submit" class="ims-staff-btn ims-staff-btn-primary ims-staff-btn-sm">Apply</button>
                    <a asp-controller="Category" asp-action="Index" class="ims-staff-btn ims-staff-btn-secondary ims-staff-btn-sm">Clear</a>
                </form>

                <section class="ims-staff-card ims-staff-table-card">
                    <div class="ims-staff-table-container">
                        <table class="ims-staff-data-table">
                            <thead>
                                <tr><th>Category</th><th>Created</th><th>Status</th><th>Actions</th></tr>
                            </thead>
                            <tbody>
                                @if (Model.Categories.Count == 0)
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-5">No categories match the current filters.</td></tr>
                                }
                                @foreach (var category in Model.Categories)
                                {
                                    <tr>
                                        <td><strong>@category.Name</strong><div class="text-muted small">@category.Description</div></td>
                                        <td>@category.CreatedDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="ims-staff-badge @(category.IsActive ? "ims-category-active" : "ims-category-inactive")">@(category.IsActive ? "Active" : "Inactive")</span></td>
                                        <td>
                                            <div class="ims-staff-actions">
                                                <button type="button" class="ims-staff-btn ims-staff-btn-secondary ims-staff-btn-sm" data-edit-category="@category.Id">Edit</button>
                                                <form asp-controller="Category" asp-action="Delete" method="post" onsubmit="return confirm('Remove this category? Categories used by ideas will be deactivated.');">
                                                    <input type="hidden" name="id" value="@category.Id" />
                                                    <button type="submit" class="ims-staff-btn ims-staff-btn-danger ims-staff-btn-sm">Remove</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="ims-staff-pagination" aria-label="Category pages">
                            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                            {
                                <a asp-controller="Category" asp-action="Index" asp-route-page="@pageNumber" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter"
                                   class="ims-staff-pagination-link @(pageNumber == Model.CurrentPage ? "ims-staff-pagination-active" : string.Empty)">@pageNumber</a>
                            }
                        </nav>
                    }
                </section>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        (() => {
            const id = document.getElementById('categoryId');
            const name = document.getElementById('categoryName');
            const description = document.getElementById('categoryDescription');
            const isActive = document.getElementById('categoryIsActive');
            const title = document.getElementById('categoryFormTitle');
            const cancel = document.getElementById('cancelEditButton');

            function resetEditor() {
                id.value = '0';
                name.value = '';
                description.value = '';
                isActive.checked = true;
                title.textContent = 'Add category';
                cancel.hidden = true;
            }

            document.querySelectorAll('[data-edit-category]').forEach(button => {
                button.addEventListener('click', async () => {
                    const response = await fetch(`/Category/Get/${button.dataset.editCategory}`);
                    if (!response.ok) return;
                    const category = await response.json();
                    id.value = category.id;
                    name.value = category.name;
                    description.value = category.description ?? '';
                    isActive.checked = category.isActive;
                    title.textContent = 'Edit category';
                    cancel.hidden = false;
                    name.focus();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
            cancel.addEventListener('click', resetEditor);
        })();
    </script>
}
