@if (User.IsInRole(RoleConstants.ItSupport))
{
    <div class="row g-4">
        <!-- User Management -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pb-2">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="ti ti-users text-primary" style="font-size: 1.5rem;"></i>
                        </div>
                        <h3 class="card-title mb-0 fw-semibold">User Management</h3>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <p class="text-muted mb-3">
                        Create new user accounts, modify existing accounts, and manage user permissions across the system. These accounts have to assist on Active Directory.
                    </p>
                    <div class="d-grid">
                        <button class="btn btn-primary">
                            <i class="ti ti-plus me-2"></i>
                            Create User
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Organization Management -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pb-2">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="ti ti-building-community text-success" style="font-size: 1.5rem;"></i>
                        </div>
                        <h3 class="card-title mb-0 fw-semibold">Cost Center Management</h3>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <p class="text-muted mb-3">
                        Assign users to Cost Centers (department), and control department access permissions. This will enable the user to budget or manage the department assigned.
                    </p>
                    <div class="d-grid">
                        <button class="btn btn-success">
                            <i class="ti ti-user-plus me-2"></i>
                            Add User to Organization
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Role Management -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pb-2">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="ti ti-shield-lock text-warning" style="font-size: 1.5rem;"></i>
                        </div>
                        <h3 class="card-title mb-0 fw-semibold">Role Management</h3>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <p class="text-muted mb-3">
                        Create and define user roles, assign specific permissions and access levels, and manage role-based security across the system.
                    </p>
                    <div class="d-grid">
                        <button class="btn btn-warning">
                            <i class="ti ti-plus me-2"></i>
                            Create Role
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
}