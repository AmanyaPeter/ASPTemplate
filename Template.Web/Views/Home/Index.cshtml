@{
    ViewData["Title"] = "Home Page";
}
@if (!User.IsInRole(RoleConstants.ItSupport))
{
    <div class="alert alert-light mb-4" role="alert">
        <h4 class="alert-heading d-flex align-items-center mb-3">
            <i class="ti ti-clock-exclamation me-2"></i>
            Important Deadlines
        </h4>
        <div class="deadline-item">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="ti ti-building text-danger me-2"></i>
                    <span><strong>Capital Budget</strong></span>
                </div>
                <div class="text-end">
                    <div class="fw-bold text-danger">30-Jun-2025</div>
                    <small class="text-muted">21 days remaining</small>
                </div>
            </div>
        </div>
        <hr />
        <div class="deadline-item">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="ti ti-calculator text-warning me-2"></i>
                    <span><strong>Operational Budget</strong></span>
                </div>
                <div class="text-end">
                    <div class="fw-bold text-warning">31-Jul-2025</div>
                    <small class="text-muted">52 days remaining</small>
                </div>
            </div>
        </div>
    </div>
}

@if (User.IsInRole(RoleConstants.BudgetOfficer) || User.IsInRole(RoleConstants.BudgetHolder))
{
    <div class="row g-4 mb-4">
        <!-- Improved Budget Status Card -->
        <div class="col-lg-7">
            <div class="card border-0 card-borderless">
                <div class="card-body">
                    <div class="card-title">
                        <h4 class=" d-flex align-items-center mb-3">
                            <i class="ti ti-clipboard-check me-2"></i>
                            My Budget Status
                        </h4>
                    </div>
                    <div class="budget-item not-submitted">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="budget-title">
                                <i class="ti ti-circle-x text-danger"></i>
                                Recurrent Budget | 2024/2025
                            </div>
                            <span class="badge bg-danger">Not Submitted</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted d-flex align-items-center">
                                <i class="ti ti-clock me-1"></i>
                                Created: 2 days ago
                            </small>
                            <button class="btn btn-outline-danger btn-sm btn-custom">
                                <i class="ti ti-eye me-1"></i>View Details
                            </button>
                        </div>
                    </div>

                    <div class="budget-item returned">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="budget-title">
                                <i class="ti ti-arrow-back text-warning"></i>
                                Capital Budget | 2024/2025
                            </div>
                            <span class="badge bg-warning">Returned</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted d-flex align-items-center">
                                <i class="ti ti-clock me-1"></i>
                                Received: 5 days ago
                            </small>
                            <button class="btn btn-outline-warning btn-sm btn-custom">
                                <i class="ti ti-eye me-1"></i>View Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 ">
                <div class="card-body">
                    <div class="card-title">
                        <div class=" d-flex align-items-center mb-3">
                            <div class="h3 position-relative">
                                <i class="ti ti-bell me-2 text-primary"></i>Notifications
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    4
                                </span>
                            </div>

                        </div>
                    </div>

                    <div class="notification-item">
                        <div class="d-flex align-items-start">
                            <i class="ti ti-alert-triangle text-warning me-2 mt-1"></i>
                            <div class="flex-grow-1">
                                <small class="text-warning fw-semibold">Capital Budget Returned</small>
                                <div class="small">Capital Budget returned for your review.</div>
                                <small class="text-muted">5 day ago</small>
                            </div>
                        </div>
                    </div>

                    <div class="notification-item">
                        <div class="d-flex align-items-start">
                            <i class="ti ti-check text-success me-2 mt-1"></i>
                            <div class="flex-grow-1">
                                <small class="text-success fw-semibold">Approved</small>
                                <div class="small">Budget was approved.</div>
                                <small class="text-muted">2 days ago</small>
                            </div>
                        </div>
                    </div>

                    <div class="notification-item">
                        <div class="d-flex align-items-start">
                            <i class="ti ti-clock text-secondary me-2 mt-1"></i>
                            <div class="flex-grow-1">
                                <small class="text-secondary fw-semibold">Reminder</small>
                                <div class="small">21 days lefts to budget deadline. After this you will request formal approval for extension.</div>
                                <small class="text-muted">21 days remaing</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid mt-3">
                        <button class="btn btn-outline-primary btn-custom">
                            <i class="ti ti-arrow-right me-2"></i>View All Notifications
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
@if (User.IsInRole(RoleConstants.BudgetAdmin) || User.IsInRole(RoleConstants.BudgetAdminViewer))
{
    <div class="row g-4 mb-4">
        <!-- Total Budgets - Info blue gradient -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-hover h-100 border-0 text-white" style="background: linear-gradient(135deg, #0dcaf0 0%, #74c0fc 100%); box-shadow: 0 4px 15px rgba(13, 202, 240, 0.3);">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-number h2 fw-bold mb-1">62</div>
                        <div class="stat-label opacity-75">Total Budgets</div>
                    </div>
                    <div>
                        <i class="ti ti-building opacity-50" style="font-size: 3rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Budgets Submitted - Enhanced green gradient -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-hover h-100 border-0 text-white" style="background: linear-gradient(135deg, #198754 0%, #51cf66 100%); box-shadow: 0 4px 15px rgba(25, 135, 84, 0.3);">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-number h2 fw-bold mb-1">50</div>
                        <div class="stat-label opacity-75">Budgets Submitted Proposed</div>
                    </div>
                    <div>
                        <i class="ti ti-file-check opacity-50" style="font-size: 3rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- In Negotiation - Strong orange gradient -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-hover h-100 border-0 text-white" style="background: linear-gradient(135deg, #198754 0%, #51cf66 100%); box-shadow: 0 4px 15px rgba(25, 135, 84, 0.3);">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-number h2 fw-bold mb-1">8</div>
                        <div class="stat-label opacity-75">Negotiated</div>
                    </div>
                    <div>
                        <i class="ti ti-file-check opacity-50" style="font-size: 3rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Returned - Bold red gradient -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-hover h-100 border-0 text-white" style="background: linear-gradient(135deg, #dc3545 0%, #ff6b6b 100%); box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="stat-number h2 fw-bold mb-1">8</div>
                        <div class="stat-label opacity-75">Pending Alignment</div>
                    </div>
                    <div>
                        <i class="ti ti-arrow-back opacity-50" style="font-size: 3rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

}
