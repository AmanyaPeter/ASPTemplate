@model SubmittedIdeasModel
@{
    ViewData["Title"] = "Submitted Ideas";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Submitted Ideas</h3>
    </div>
    <div class="card-body">
        <form asp-controller="Idea" asp-action="AllIdeas" method="get" class="row g-2 mb-3">
            <div class="col-auto flex-grow-1">
                <input type="text" class="form-control" placeholder="Search by title or submitter..." asp-for="SearchTerm">
            </div>
            <div class="col-auto">
                <select class="form-select" asp-for="StatusFilter">
                    <option value="">All Statuses</option>
                    <option value="Submitted">Submitted</option>
                    <option value="Under Review">Under Review</option>
                    <option value="Pending Information">Pending Information</option>
                    <option value="Approved">Approved</option>
                    <option value="Declined">Declined</option>
                </select>
            </div>
            <div class="col-auto">
                <select class="form-select" asp-for="CategoryFilter">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-auto">
                <select class="form-select" asp-for="DepartmentFilter">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-auto">
                <input type="date" class="form-control" asp-for="DateFrom">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Apply</button>
                <a asp-controller="Idea" asp-action="AllIdeas" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Idea Title</th>
                        <th>Submitter</th>
                        <th>Department</th>
                        <th>Category</th>
                        <th>Stage</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="w-1">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var idea in Model.Ideas)
                    {
                        <tr>
                            <td><strong>@idea.Title</strong></td>
                            <td>@idea.Submitter</td>
                            <td>@idea.Department</td>
                            <td>@idea.CategoryName</td>
                            <td><span class="badge bg-blue-lt">@idea.Stage</span></td>
                            <td><span class="badge bg-secondary-lt">@idea.Status</span></td>
                            <td>@idea.SubmissionDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-controller="Idea" asp-action="Review" asp-route-id="@idea.Id" class="btn btn-sm @(idea.NeedsReview ? "btn-primary" : "btn-outline-secondary")">
                                    @(idea.NeedsReview ? "Review" : "View Review")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-3">
                <nav>
                    <ul class="pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Idea" asp-action="AllIdeas" asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-categoryFilter="@Model.CategoryFilter" asp-route-departmentFilter="@Model.DepartmentFilter"
                                   asp-route-dateFrom="@Model.DateFrom">&laquo; Previous</a>
                            </li>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="Idea" asp-action="AllIdeas" asp-route-page="@i"
                                   asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-categoryFilter="@Model.CategoryFilter" asp-route-departmentFilter="@Model.DepartmentFilter"
                                   asp-route-dateFrom="@Model.DateFrom">@i</a>
                            </li>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Idea" asp-action="AllIdeas" asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-categoryFilter="@Model.CategoryFilter" asp-route-departmentFilter="@Model.DepartmentFilter"
                                   asp-route-dateFrom="@Model.DateFrom">Next &raquo;</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>