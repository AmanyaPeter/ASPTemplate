@model IdeaDetailsModel
@{
    ViewData["Title"] = "Idea Details";
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="mb-3">
    <a asp-controller="Idea" asp-action="MyIdeas" class="text-muted">&larr; Back to My Ideas</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="card-title mb-1">@Model.Idea.Title</h2>
                <p class="text-muted">Submitted on @Model.Idea.SubmissionDate.ToString("dd MMM yyyy") by @Model.Idea.Submitter</p>
                <div class="mb-3">
                    <span class="badge bg-secondary-lt me-1">@Model.Idea.Status</span>
                    <span class="badge bg-blue-lt">@Model.Idea.Stage</span>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Description</h3></div>
            <div class="card-body"><p class="mb-0">@Model.Idea.SummaryDescription</p></div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Problem Statement</h3></div>
            <div class="card-body"><p class="mb-0">@Model.Idea.ProblemStatement</p></div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Proposed Solution</h3></div>
            <div class="card-body"><p class="mb-0">@Model.Idea.ProposedSolution</p></div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Attachments</h3></div>
            <div class="card-body">
                @if (Model.Idea.Attachments.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var attachment in Model.Idea.Attachments)
                        {
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" asp-controller="Idea" asp-action="DownloadAttachment" asp-route-id="@attachment.Id">
                                <i class="ti ti-paperclip"></i> @attachment.FileName
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No attachments.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">Comments</h3></div>
            <div class="card-body">
                @if (Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="d-flex mb-3">
                            <div class="me-2"><span class="avatar avatar-sm">@comment.Avatar</span></div>
                            <div>
                                <div><strong>@comment.Author</strong> <span class="text-muted ms-2 small">@comment.Role &middot; @comment.TimeAgo</span></div>
                                <div class="mt-1">@comment.Text</div>
                            </div>
                        </div>
                    }
                }
                <form method="post" asp-controller="Idea" asp-action="AddComment" asp-route-id="@Model.Idea.Id" class="mt-3">
                    <textarea class="form-control" rows="2" placeholder="Write a comment..." name="newComment"></textarea>
                    <button type="submit" class="btn btn-primary mt-2">Send</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Progress Tracker</h3></div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @foreach (var entry in Model.TimelineEntries)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@entry.StageName</span>
                            <span class="text-muted small">@entry.Date.ToString("dd MMM yyyy")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">Timeline</h3></div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @foreach (var entry in Model.TimelineEntries)
                    {
                        <div class="list-group-item d-flex justify-content-between">
                            <span>@entry.StageName</span>
                            <span class="text-muted small">@entry.Date.ToString("dd MMM yyyy")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>