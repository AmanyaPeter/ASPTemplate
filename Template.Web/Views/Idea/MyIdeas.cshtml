@model MyIdeasModel
@{
    ViewData["Title"] = "My Ideas";
}
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">My Ideas</h3>
    </div>
    <div class="card-body">
        <form asp-controller="Idea" asp-action="MyIdeas" method="get" class="row g-2 mb-3">
            <div class="col-auto flex-grow-1">
                <input type="text" class="form-control" placeholder="Search ideas..." asp-for="SearchTerm">
            </div>
            <div class="col-auto">
                <select class="form-select" asp-for="StatusFilter">
                    <option value="">All Statuses</option>
                    <option value="Submitted">Submitted</option>
                    <option value="Under Review">Under Review</option>
                    <option value="Pending Information">Pending Information</option>
                    <option value="Approved">Approved</option>
                    <option value="Declined">Declined</option>
                </select>
            </div>
            <div class="col-auto">
                <select class="form-select" asp-for="CategoryFilter">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Idea</th>
                        <th>Category</th>
                        <th>Stage</th>
                        <th>Status</th>
                        <th>Date Submitted</th>
                        <th class="w-1">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var idea in Model.Ideas)
                    {
                        <tr class="@(idea.IsRetracted ? "text-muted" : "")">
                            <td>@idea.Title</td>
                            <td>@idea.CategoryName</td>
                            <td><span class="badge bg-blue-lt">@idea.Stage</span></td>
                            <td><span class="badge @(idea.IsRetracted ? "bg-danger-lt" : "bg-secondary-lt")">@idea.Status</span></td>
                            <td>@idea.SubmissionDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Idea" asp-action="Details" asp-route-id="@idea.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                    @if (!idea.IsRetracted)
                                    {
                                        <form asp-controller="IdeaStaffActions" asp-action="Retract" asp-route-id="@idea.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('Are you sure you want to retract this idea?')">Retract</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="IdeaStaffActions" asp-action="Cancel" asp-route-id="@idea.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure? This action cannot be undone.')">Cancel</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-3">
                <nav>
                    <ul class="pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Idea" asp-action="MyIdeas" asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-categoryFilter="@Model.CategoryFilter">&laquo; Previous</a>
                            </li>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="Idea" asp-action="MyIdeas" asp-route-page="@i"
                                   asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-categoryFilter="@Model.CategoryFilter">@i</a>
                            </li>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Idea" asp-action="MyIdeas" asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-categoryFilter="@Model.CategoryFilter">Next &raquo;</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>