@model ReviewIdeaModel
@{
    ViewData["Title"] = "Review Idea";
    string StageLabel(IdeaStage stage) => stage == IdeaStage.ConceptDevelopment
        ? "Concept Development"
        : stage.ToString();
    string StatusLabel(IdeaStatus status) => status switch
    {
        IdeaStatus.PendingInformation => "Pending Information",
        IdeaStatus.UnderReview => "Under Review",
        _ => status.ToString()
    };
}

<div class="prototype-heading review-page-heading">
    <div>
        <a asp-controller="Idea" asp-action="AllIdeas" class="review-back-link">
            <i class="ti ti-arrow-left"></i>
            Back to submitted ideas
        </a>
        <h1>@Model.Idea.Title</h1>
        <p>Submitted by @Model.Idea.Submitter from @Model.Idea.SubmitterBusinessUnit on @Model.Idea.SubmissionDate.ToString("dd MMM yyyy").</p>
    </div>
    <a asp-controller="Idea" asp-action="Pipeline" class="prototype-button secondary">
        <i class="ti ti-layout-kanban"></i>
        Open pipeline
    </a>
</div>

<div class="review-workspace">
    <div class="review-main-column">
        <section class="prototype-card review-idea-card">
            <div class="review-card-heading">
                <div>
                    <span class="review-eyebrow">Submitted idea</span>
                    <h2>@Model.Idea.Title</h2>
                </div>
                <span class="pipeline-category">@Model.Idea.Category</span>
            </div>

            <div class="review-detail-section">
                <h3>Summary</h3>
                <p>@Model.Idea.SummaryDescription</p>
            </div>
            <div class="review-detail-section">
                <h3>Problem statement</h3>
                <p>@Model.Idea.ProblemStatement</p>
            </div>
            <div class="review-detail-section">
                <h3>Proposed solution</h3>
                <p>@Model.Idea.ProposedSolution</p>
            </div>

            <div class="review-detail-grid">
                <div class="review-detail-section">
                    <h3>Expected benefits</h3>
                    <p>@(string.IsNullOrWhiteSpace(Model.Idea.ExpectedBenefits) ? "Not provided" : Model.Idea.ExpectedBenefits)</p>
                </div>
                <div class="review-detail-section">
                    <h3>Key enablers and resources</h3>
                    <p>@(string.IsNullOrWhiteSpace(Model.Idea.KeyEnablers) ? "Not provided" : Model.Idea.KeyEnablers)</p>
                </div>
                <div class="review-detail-section">
                    <h3>Implementation approach</h3>
                    <p>@(string.IsNullOrWhiteSpace(Model.Idea.ImplementationApproach) ? "Not provided" : Model.Idea.ImplementationApproach)</p>
                </div>
                <div class="review-detail-section">
                    <h3>Impact indicators</h3>
                    <p>@(string.IsNullOrWhiteSpace(Model.Idea.ImpactIndicators) ? "Not provided" : Model.Idea.ImpactIndicators)</p>
                </div>
            </div>

            <div class="review-detail-section">
                <h3>Strategic objective</h3>
                <p>@(string.IsNullOrWhiteSpace(Model.Idea.StrategicObjective) ? "Not provided" : Model.Idea.StrategicObjective)</p>
            </div>

            <div class="review-detail-section">
                <h3>Attachments</h3>
                @if (Model.Idea.Attachments.Count == 0)
                {
                    <p class="review-empty-copy">No supporting files were attached.</p>
                }
                else
                {
                    <div class="review-attachment-list">
                        @foreach (var attachment in Model.Idea.Attachments)
                        {
                            <a asp-controller="IdeaStaffActions" asp-action="DownloadAttachment" asp-route-id="@attachment.Id"
                               class="review-attachment">
                                <i class="ti ti-paperclip"></i>
                                <span>@attachment.FileName</span>
                                <i class="ti ti-download"></i>
                            </a>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="prototype-card review-comments-card">
            <div class="review-card-heading">
                <div>
                    <span class="review-eyebrow">Conversation</span>
                    <h2>Comments with the submitter</h2>
                </div>
                <i class="ti ti-message-circle"></i>
            </div>

            @if (Model.Comments.Count == 0)
            {
                <p class="review-empty-copy">No comments have been sent yet.</p>
            }
            else
            {
                <div class="review-comment-thread">
                    @foreach (var comment in Model.Comments)
                    {
                        <article class="review-comment">
                            <span class="review-comment-avatar">@comment.Avatar</span>
                            <div>
                                <header><strong>@comment.Author</strong><span>@comment.Role · @comment.TimeAgo</span></header>
                                <p>@comment.Text</p>
                            </div>
                        </article>
                    }
                </div>
            }

            <form asp-controller="IdeaWorkflow" asp-action="AddComment" asp-route-id="@Model.Idea.Id"
                  method="post" class="review-comment-form" data-loading>
                <label for="newComment">Send a comment to the staff submitter</label>
                <textarea id="newComment" name="newComment" rows="4" required maxlength="2000"
                          placeholder="Write feedback, request clarification, or share the next action..."></textarea>
                <div>
                    <small>The submitter will receive an in-app notification and email.</small>
                    <button type="submit" class="prototype-button">
                        <i class="ti ti-send"></i>
                        Send comment
                    </button>
                </div>
            </form>
        </section>
    </div>

    <aside class="review-side-column">
        <section class="prototype-card review-controls-card">
            <div class="review-card-heading">
                <div>
                    <span class="review-eyebrow">Workflow controls</span>
                    <h2>Update status and stage</h2>
                </div>
                <i class="ti ti-adjustments"></i>
            </div>

            <form method="post" asp-controller="IdeaWorkflow" asp-action="SaveReview"
                  asp-route-id="@Model.Idea.Id" class="review-controls-form" data-loading>
                <input type="hidden" asp-for="Review.RowVersion" />
                <div>
                    <label asp-for="Review.Status">Status</label>
                    <select asp-for="Review.Status">
                        @foreach (var status in Enum.GetValues<IdeaStatus>())
                        {
                            <option value="@status" selected="@(Model.Review.Status == status.ToString() ? "selected" : null)">@StatusLabel(status)</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="Review.Stage">Stage</label>
                    <select asp-for="Review.Stage">
                        @foreach (var stage in Enum.GetValues<IdeaStage>())
                        {
                            <option value="@stage" selected="@(Model.Review.Stage == stage.ToString() ? "selected" : null)">@StageLabel(stage)</option>
                        }
                    </select>
                    <small>Ideas move one stage at a time. Approve an idea when advancing it.</small>
                </div>
                <div>
                    <label asp-for="Review.TimelineDate">Stage deadline</label>
                    <input asp-for="Review.TimelineDate" type="date" />
                </div>
                <div>
                    <label asp-for="Review.AssignedReviewerId">Assigned reviewer</label>
                    <select asp-for="Review.AssignedReviewerId">
                        <option value="">Unassigned</option>
                        @foreach (var reviewer in Model.Reviewers)
                        {
                            <option value="@reviewer.Id">@reviewer.FullName</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="Review.Notes">Decision reason or notes</label>
                    <textarea asp-for="Review.Notes" rows="4" maxlength="2000"
                              placeholder="Record why the status or stage is changing."></textarea>
                </div>
                <button type="submit" class="prototype-button">
                    <i class="ti ti-device-floppy"></i>
                    Save and notify submitter
                </button>
            </form>
        </section>

        <section class="prototype-card review-workflow-card">
            <div class="review-card-heading">
                <div>
                    <span class="review-eyebrow">Progress</span>
                    <h2>Approval workflow</h2>
                </div>
            </div>
            <ol class="review-workflow-list">
                @foreach (var step in Model.WorkflowSteps)
                {
                    <li class="@(step.IsComplete ? "complete" : step.IsPending ? "current" : null)">
                        <span><i class="ti @(step.IsComplete ? "ti-circle-check" : step.IsPending ? "ti-clock" : "ti-circle")"></i></span>
                        <div>
                            <strong>@(step.Name == nameof(IdeaStage.ConceptDevelopment) ? "Concept Development" : step.Name)</strong>
                            <small>@(step.IsComplete ? "Complete" : step.IsPending ? "Current stage" : "Not started")</small>
                        </div>
                    </li>
                }
            </ol>
        </section>
    </aside>
</div>
