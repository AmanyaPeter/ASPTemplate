@model ReviewIdeaModel
@{
    ViewData["Title"] = "Review Idea";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <a asp-controller="Idea" asp-action="AllIdeas" class="text-muted">&larr; Back to review queue</a>
        <h2 class="mt-2 mb-1">@Model.Idea.Title</h2>
        <div class="text-muted">Submitted by @Model.Idea.Submitter, @Model.Idea.SubmitterBusinessUnit on @Model.Idea.SubmissionDate.ToString("dd MMM yyyy")</div>
    </div>
</div>

    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <!-- Back Link -->
            <div class="ims-staff-back-link">
                <a asp-controller="Idea" asp-action="AllIdeas" class="ims-staff-back-link-anchor">&larr; Back to Submitted Ideas</a>
            </div>
        </div>

            <!-- Review Grid -->
            <div class="ims-staff-review-grid">
                <!-- Left Column -->
                <div>
                    <!-- Idea Details -->
                    <div class="ims-staff-card">
                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-title">@Model.Idea.Title</h3>
                            <p class="ims-staff-detail-meta">
                                Submitted by <strong>@Model.Idea.Submitter</strong> &middot; @Model.Idea.SubmitterBusinessUnit &middot; @Model.Idea.SubmissionDate.ToString("dd MMM yyyy")
                            </p>
                        </div>

                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-section-title">Summary</h3>
                            <p class="ims-staff-detail-text">@Model.Idea.SummaryDescription</p>
                        </div>

                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-section-title">Problem Statement</h3>
                            <p class="ims-staff-detail-text">@Model.Idea.ProblemStatement</p>
                        </div>

                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-section-title">Proposed Solution</h3>
                            <p class="ims-staff-detail-text">@Model.Idea.ProposedSolution</p>
                        </div>

                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-section-title">Attachments</h3>
                            <div class="ims-staff-attachment-list">
                                @foreach (var attachment in Model.Idea.Attachments)
                                {
                                    <a class="ims-staff-attachment-item" asp-action="DownloadAttachment" asp-route-id="@attachment.Id">
                                        <i data-lucide="@attachment.Icon" style="width:14px;height:14px;vertical-align:middle;"></i> 
                                        @attachment.FileName
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-section-title">Strategic Alignment</h3>
                            <p><strong>Strategic Objective:</strong> @Model.Idea.StrategicObjective</p>
                            <p><strong>SDG Contribution:</strong> @Model.Idea.SDGContribution</p>
                        </div>
                    </div>

                    <!-- Comments Section -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h3 class="card-title">Comments</h3>
                        </div>
                        <div class="card-body">
                            @if (Model.Comments.Any())
                            {
                                @foreach (var comment in Model.Comments)
                                {
                                    <div class="d-flex mb-3">
                                        <div class="me-2">
                                            <span class="avatar avatar-sm">@comment.Avatar</span>
                                        </div>
                                        <div>
                                            <div><strong>@comment.Author</strong> <span class="text-muted ms-2">@comment.Role</span></div>
                                            <div class="text-muted small">@comment.TimeAgo</div>
                                            <div class="mt-1">@comment.Text</div>
                                        </div>
                                    </div>
                                }
                            }
                            <form asp-controller="Idea" asp-action="AddComment" asp-route-id="@Model.Idea.Id" method="post" class="mt-3">
                                <textarea name="newComment" class="form-control" rows="2" required placeholder="Add a comment for the submitter"></textarea>
                                <button type="submit" class="btn btn-primary mt-2">Send</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header"><h3 class="card-title">Review controls</h3></div>
                    <div class="card-body">
                        <form asp-controller="IdeaWorkflow" asp-action="SaveReview" asp-route-id="@Model.Idea.Id" method="post">
                            <div class="mb-3">
                                <label asp-for="Review.Status" class="form-label">Status</label>
                                <select asp-for="Review.Status" asp-items="Html.GetEnumSelectList<IdeaStatus>()" class="form-select"></select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Review.Stage" class="form-label">Stage</label>
                                <select asp-for="Review.Stage" asp-items="Html.GetEnumSelectList<IdeaStage>()" class="form-select"></select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Review.TimelineDate" class="form-label">Stage deadline</label>
                                <input asp-for="Review.TimelineDate" type="date" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Review.AssignedReviewerId" class="form-label">Assigned reviewer</label>
                                <select asp-for="Review.AssignedReviewerId" class="form-select">
                                    <option value="">Unassigned</option>
                                    @foreach (var reviewer in Model.Reviewers)
                                    {
                                        <option value="@reviewer.Id">@reviewer.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Review.Notes" class="form-label">Reason / notes</label>
                                <textarea asp-for="Review.Notes" class="form-control" rows="3"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Save review and notify submitter</button>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><h3 class="card-title">Workflow</h3></div>
                    <div class="list-group list-group-flush">
                        @foreach (var step in Model.WorkflowSteps)
                        {
                            <div class="list-group-item d-flex justify-content-between">
                                <span>@step.Name</span>
                                @if (step.IsComplete)
                                {
                                    <span class="badge bg-success-lt">Complete</span>
                                }
                                else if (step.IsPending)
                                {
                                    <span class="badge bg-warning-lt">Current</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">Not started</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
