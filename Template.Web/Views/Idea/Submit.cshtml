@model SubmitIdeaModel
@{
    ViewData["Title"] = "Submit Idea";
}

<div class="submission-intro">
    <span class="submission-intro-icon"><i class="ti ti-bulb"></i></span>
    <div><h1>Idea Submission Form</h1><p>Complete the four stages below. Fields marked <strong>*</strong> are required.</p></div>
</div>

<div class="ims-staff-stepper">
    <div class="ims-staff-stepper-step ims-staff-stepper-active" data-step="1">
        <span class="ims-staff-step-number">1</span>
        <span class="ims-staff-step-text">Innovator Information</span>
    </div>
    <div class="ims-staff-stepper-connector"></div>
    <div class="ims-staff-stepper-step" data-step="2">
        <span class="ims-staff-step-number">2</span>
        <span class="ims-staff-step-text">Innovation Idea</span>
    </div>
    <div class="ims-staff-stepper-connector"></div>
    <div class="ims-staff-stepper-step" data-step="3">
        <span class="ims-staff-step-number">3</span>
        <span class="ims-staff-step-text">Strategic Alignment</span>
    </div>
    <div class="ims-staff-stepper-connector"></div>
    <div class="ims-staff-stepper-step" data-step="4">
        <span class="ims-staff-step-number">4</span>
        <span class="ims-staff-step-text">Benefits & Implementation</span>
    </div>
</div>

<div class="card">
    <form asp-controller="Idea" asp-action="Submit" method="post" enctype="multipart/form-data" id="submitForm">
        <div class="card-body">
            <div class="ims-staff-form-page ims-staff-form-page-active" id="step1">
                <h3 class="ims-staff-form-page-title">Innovator Details</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="FullName" class="form-label">Full Name *</label>
                        <input type="text" id="FullName" class="form-control" asp-for="Innovator.FullName" placeholder="Enter your full name">
                        <span asp-validation-for="Innovator.FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label for="Email" class="form-label">Email *</label>
                        <input type="email" id="Email" class="form-control" asp-for="Innovator.Email" placeholder="Enter your email">
                        <span asp-validation-for="Innovator.Email" class="text-danger"></span>
                    </div>
                </div>

                <fieldset class="mt-3 mb-3">
                    <legend class="form-label">Are you submitting this idea as an individual or a team?</legend>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="SubmissionType" value="individual" checked asp-for="SubmissionType" onchange="toggleSubmissionType()">
                        <label class="form-check-label">Individual</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="SubmissionType" value="team" asp-for="SubmissionType" onchange="toggleSubmissionType()">
                        <label class="form-check-label">Team</label>
                    </div>
                </fieldset>

                <div id="individualSection">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="BusinessUnit" class="form-label">Business Unit *</label>
                            <input type="text" id="BusinessUnit" class="form-control" asp-for="Innovator.BusinessUnit" placeholder="e.g. Finance, IT, Operations">
                        </div>
                        <div class="col-md-6">
                            <label for="DutyStation" class="form-label">Duty Station *</label>
                            <input type="text" id="DutyStation" class="form-control" asp-for="Innovator.DutyStation" placeholder="e.g. Kampala">
                        </div>
                        <div class="col-md-6">
                            <label for="InnovatorAge" class="form-label">Age Bracket *</label>
                            <input type="text" id="InnovatorAge" class="form-control" asp-for="Innovator.Age" placeholder="e.g. 25-34">
                        </div>
                        <div class="col-md-6">
                            <label for="InnovatorGender" class="form-label">Gender *</label>
                            <input type="text" id="InnovatorGender" class="form-control" asp-for="Innovator.Gender" placeholder="e.g. Male, Female">
                        </div>
                        <div class="col-md-6">
                            <label for="InnovatorRank" class="form-label">Rank/Title *</label>
                            <input type="text" id="InnovatorRank" class="form-control" asp-for="Innovator.Rank" placeholder="e.g. Senior Officer">
                        </div>
                    </div>
                </div>

                <div id="teamSection" style="display:none;">
                    <div class="mb-3">
                        <label for="TeamMemberNames" class="form-label">Team Member Names *</label>
                        <textarea id="TeamMemberNames" class="form-control" asp-for="Innovator.TeamMemberNames" rows="3" placeholder="Enter names of team members, one per line"></textarea>
                    </div>
                </div>
            </div>

            <div class="ims-staff-form-page" id="step2" style="display:none;">
                <h3 class="ims-staff-form-page-title">Innovation Idea Details</h3>
                <div class="mb-3">
                    <label asp-for="Idea.Title" class="form-label">Idea Title *</label>
                    <input type="text" class="form-control" asp-for="Idea.Title" placeholder="What is the title of your innovation?">
                    <span asp-validation-for="Idea.Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Idea.SummaryDescription" class="form-label">Brief Description *</label>
                    <textarea class="form-control" asp-for="Idea.SummaryDescription" rows="3" placeholder="Summarize your innovation in 2-3 sentences"></textarea>
                    <span asp-validation-for="Idea.SummaryDescription" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Idea.ProblemStatement" class="form-label">Problem Statement *</label>
                    <textarea class="form-control" asp-for="Idea.ProblemStatement" rows="4" placeholder="What problem or opportunity does your innovation address?"></textarea>
                    <span asp-validation-for="Idea.ProblemStatement" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Idea.ProposedSolution" class="form-label">Proposed Solution *</label>
                    <textarea class="form-control" asp-for="Idea.ProposedSolution" rows="4" placeholder="Describe your proposed solution or approach"></textarea>
                    <span asp-validation-for="Idea.ProposedSolution" class="text-danger"></span>
                </div>
            </div>

            <div class="ims-staff-form-page" id="step3" style="display:none;">
                <h3 class="ims-staff-form-page-title">Strategic Alignment</h3>
                <div class="mb-3">
                    <label asp-for="Idea.Category" class="form-label">Innovation Category *</label>
                    <select class="form-select" asp-for="Idea.Category">
                        <option value="">Select a category...</option>
                    </select>
                    <span asp-validation-for="Idea.Category" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Idea.StrategicObjective" class="form-label">Strategic Objective</label>
                    <textarea class="form-control" asp-for="Idea.StrategicObjective" rows="3" placeholder="How does this innovation align with the Bank's strategic objectives?"></textarea>
                </div>
            </div>

            <div class="ims-staff-form-page" id="step4" style="display:none;">
                <h3 class="ims-staff-form-page-title">Benefits & Implementation</h3>
                <div class="mb-3">
                    <label asp-for="Idea.ExpectedBenefits" class="form-label">Expected Benefits *</label>
                    <textarea class="form-control" asp-for="Idea.ExpectedBenefits" rows="3" placeholder="Describe the expected benefits of your innovation"></textarea>
                    <span asp-validation-for="Idea.ExpectedBenefits" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Idea.KeyEnablers" class="form-label">Key Enablers *</label>
                    <textarea class="form-control" asp-for="Idea.KeyEnablers" rows="3" placeholder="What key resources or support are needed to implement this innovation?"></textarea>
                    <span asp-validation-for="Idea.KeyEnablers" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Idea.ImplementationApproach" class="form-label">Implementation Approach *</label>
                    <textarea class="form-control" asp-for="Idea.ImplementationApproach" rows="4" placeholder="Describe your approach to implementing this innovation"></textarea>
                    <span asp-validation-for="Idea.ImplementationApproach" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Idea.ImpactIndicators" class="form-label">Impact Indicators *</label>
                    <textarea class="form-control" asp-for="Idea.ImpactIndicators" rows="3" placeholder="How will success be measured?"></textarea>
                    <span asp-validation-for="Idea.ImpactIndicators" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Attachments (optional)</label>
                    <input type="file" id="fileInput" name="Attachments" multiple class="form-control" />
                </div>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between">
            <button type="button" class="btn btn-outline-secondary" onclick="prevStep(currentStep)" id="prevBtn" style="display:none;">Back</button>
            <div>
                <button type="button" class="btn btn-outline-secondary me-2" onclick="nextStep(currentStep)" id="nextBtn">Next</button>
                <button type="submit" class="btn btn-success" id="submitBtn" style="display:none;"><i class="ti ti-send me-1"></i> Submit Idea</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let currentStep = 1;

        function toggleSubmissionType() {
            const isTeam = document.querySelector('input[name="SubmissionType"]:checked').value === 'team';
            document.getElementById('individualSection').style.display = isTeam ? 'none' : 'block';
            document.getElementById('teamSection').style.display = isTeam ? 'block' : 'none';
        }

        function showStep(step) {
            for (let i = 1; i <= 4; i++) {
                document.getElementById('step' + i).style.display = i === step ? 'block' : 'none';
            }
            document.querySelectorAll('.ims-staff-stepper-step').forEach((s, i) => {
                s.classList.toggle('ims-staff-stepper-active', i + 1 === step);
            });
            document.getElementById('prevBtn').style.display = step > 1 ? 'inline-block' : 'none';
            document.getElementById('nextBtn').style.display = step < 4 ? 'inline-block' : 'none';
            document.getElementById('submitBtn').style.display = step === 4 ? 'inline-block' : 'none';
            currentStep = step;
        }

        function nextStep(step) {
            if (step < 4) showStep(step + 1);
        }

        function prevStep(step) {
            if (step > 1) showStep(step - 1);
        }

        toggleSubmissionType();
    </script>
}