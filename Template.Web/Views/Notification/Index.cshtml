@model NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h2 class="mb-1">Notifications</h2>
        <div class="text-muted">@Model.UnreadCount unread notification(s)</div>
    </div>
    @if (Model.UnreadCount > 0)
    {
        <form asp-controller="Notification" asp-action="MarkAllRead" method="post">
            <button type="submit" class="btn btn-outline-primary">
                <i class="ti ti-checks me-1"></i>Mark all as read
            </button>
        </form>
    }
</div>

<div class="card">
    <div class="card-header">
        <div class="btn-group">
            <a asp-controller="Notification" asp-action="Index" asp-route-filter="all" class="btn @(Model.Filter == "all" ? "btn-primary" : "btn-outline-primary")">All</a>
            <a asp-controller="Notification" asp-action="Index" asp-route-filter="unread" class="btn @(Model.Filter == "unread" ? "btn-primary" : "btn-outline-primary")">Unread</a>
            <a asp-controller="Notification" asp-action="Index" asp-route-filter="read" class="btn @(Model.Filter == "read" ? "btn-primary" : "btn-outline-primary")">Read</a>
        </div>
    </div>
    <div class="list-group list-group-flush">
        @if (Model.Notifications.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="ti ti-bell-off fs-1 d-block mb-2"></i>
                No notifications found.
            </div>
        }
        @foreach (var notification in Model.Notifications)
        {
            <div class="list-group-item @(!notification.IsRead ? "bg-blue-lt" : string.Empty)">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="fw-semibold">@notification.Subject</div>
                        <div class="text-muted">@notification.Message</div>
                        <div class="small text-muted mt-1">@notification.TimeAgo</div>
                    </div>
                    @if (!notification.IsRead)
                    {
                        <form asp-controller="Notification" asp-action="MarkRead" method="post">
                            <input type="hidden" name="id" value="@notification.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Mark read</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-center">
            <ul class="pagination mb-0">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                        <a asp-controller="Notification" asp-action="Index" asp-route-filter="@Model.Filter" asp-route-page="@pageNumber" class="page-link">@pageNumber</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
