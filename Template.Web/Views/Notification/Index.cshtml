@model NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="prototype-heading">
    <div>
        <h1>Notifications</h1>
        <p>@Model.UnreadCount unread notification@(Model.UnreadCount == 1 ? "" : "s")</p>
    </div>
    @if (Model.UnreadCount > 0)
    {
        <form asp-controller="Notification" asp-action="MarkAllRead" asp-route-filter="@Model.Filter" method="post" data-loading>
            <button type="submit" class="prototype-button secondary">
                <i class="ti ti-checks"></i>
                Mark all as read
            </button>
        </form>
    }
</div>

<section class="prototype-card notification-center">
    <nav class="notification-tabs" aria-label="Notification filters">
        <a asp-action="Index" asp-route-filter="all" class="@(Model.Filter == "all" ? "active" : "")">All</a>
        <a asp-action="Index" asp-route-filter="unread" class="@(Model.Filter == "unread" ? "active" : "")">
            Unread
            @if (Model.UnreadCount > 0)
            {
                <span>@Model.UnreadCount</span>
            }
        </a>
        <a asp-action="Index" asp-route-filter="read" class="@(Model.Filter == "read" ? "active" : "")">Read</a>
    </nav>

    @if (Model.Notifications.Count == 0)
    {
        <div class="admin-empty-state">
            <i class="ti ti-bell-off"></i>
            <h2>No notifications</h2>
            <p>You are all caught up. New workflow and support updates will appear here.</p>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in Model.Notifications)
            {
                <article class="notification-row @(!notification.IsRead ? "unread" : "")">
                    <span class="notification-row-icon"><i class="ti ti-@notification.Icon"></i></span>
                    <div>
                        <h2>@notification.Subject</h2>
                        <p>@notification.Message</p>
                        <time>@notification.TimeAgo</time>
                    </div>
                    <div class="notification-row-actions">
                        @if (!string.IsNullOrWhiteSpace(notification.LinkUrl))
                        {
                            <a href="@notification.LinkUrl" class="prototype-button secondary">
                                <i class="ti ti-arrow-up-right"></i>Open
                            </a>
                        }
                        @if (!notification.IsRead)
                        {
                            <form asp-action="MarkRead" asp-route-id="@notification.Id" asp-route-filter="@Model.Filter" method="post" data-loading>
                                <button type="submit" class="prototype-button secondary">
                                    <i class="ti ti-check"></i>Mark read
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Notification pages" class="category-pagination">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <a asp-action="Index"
                   asp-route-filter="@Model.Filter"
                   asp-route-page="@pageNumber"
                   class="@(pageNumber == Model.CurrentPage ? "active" : "")">
                    @pageNumber
                </a>
            }
        </nav>
    }
</section>
