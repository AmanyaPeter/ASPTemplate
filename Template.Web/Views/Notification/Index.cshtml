@model NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h2 class="mb-1">Notifications</h2>
        <div class="text-muted">@Model.UnreadCount unread notification(s)</div>
    </div>
    @if (Model.UnreadCount > 0)
    {
        <form asp-controller="Notification" asp-action="MarkAllRead" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary"><i class="ti ti-checks me-1"></i>Mark all as read</button>
        </form>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="d-flex border-bottom">
            <a asp-controller="Notification" asp-action="Index" asp-route-filter="all" class="btn btn-ghost-primary @(Model.Filter == "all" ? "active" : "")">All</a>
            <a asp-controller="Notification" asp-action="Index" asp-route-filter="unread" class="btn btn-ghost-primary @(Model.Filter == "unread" ? "active" : "")">
                Unread @if (Model.UnreadCount > 0) {<span class="badge bg-primary ms-1">@Model.UnreadCount</span>}
            </a>
            <a asp-controller="Notification" asp-action="Index" asp-route-filter="read" class="btn btn-ghost-primary @(Model.Filter == "read" ? "active" : "")">Read</a>
        </div>

        @if (Model.Notifications.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var notification in Model.Notifications)
                {
                    <div class="list-group-item d-flex align-items-start gap-3 @(!notification.IsRead ? "bg-blue-lt" : "")">
                        <div class="mt-1"><i class="ti ti-bell" style="font-size:1.2rem;"></i></div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@notification.Subject</div>
                            <div class="text-muted small">@notification.Message</div>
                            <div class="text-muted small mt-1">@notification.TimeAgo</div>
                        </div>
                        @if (!notification.IsRead)
                        {
                            <form method="post" asp-action="MarkRead" asp-route-id="@notification.Id" asp-route-filter="@Model.Filter">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark read</button>
                            </form>
                        }
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="card-footer d-flex justify-content-center">
                    <nav>
                        <ul class="pagination mb-0">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Notification" asp-action="Index" asp-route-filter="@Model.Filter" asp-route-page="@(Model.CurrentPage - 1)">&laquo; Previous</a>
                                </li>
                            }
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-controller="Notification" asp-action="Index" asp-route-filter="@Model.Filter" asp-route-page="@i">@i</a>
                                </li>
                            }
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Notification" asp-action="Index" asp-route-filter="@Model.Filter" asp-route-page="@(Model.CurrentPage + 1)">Next &raquo;</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="ti ti-bell-off" style="font-size:3rem;color:#ccc;"></i>
                <h4 class="mt-3">No notifications</h4>
                <p class="text-muted">You're all caught up! Check back later for updates.</p>
            </div>
        }
    </div>
</div>