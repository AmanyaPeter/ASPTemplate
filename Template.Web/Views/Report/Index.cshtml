@model ReportsModel
@{
    ViewData["Title"] = "Reports and Analytics";
}

<div class="ims-staff-page">
    <div class="ims-staff-page-header">
        <div>
            <p class="ims-staff-page-eyebrow">Innovation performance</p>
            <h1 class="ims-staff-page-title">Reports and Analytics</h1>
            <p class="ims-staff-page-description">Filter innovation records and export the same result set as CSV or Excel.</p>
        </div>
    </div>

    <section class="card mb-4">
        <div class="card-header"><h3 class="card-title">Report filters</h3></div>
        <div class="card-body">
            <form method="get" asp-controller="Report" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-2"><label for="startDate" class="form-label">From</label><input id="startDate" name="StartDate" type="date" value="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" class="form-control" /></div>
                    <div class="col-md-2"><label for="endDate" class="form-label">To</label><input id="endDate" name="EndDate" type="date" value="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" class="form-control" /></div>
                    <div class="col-md-2"><label for="department" class="form-label">Department</label><select id="department" name="Department" class="form-select"><option value="">All departments</option>@foreach (var item in Model.Departments) { <option value="@item" selected="@(item == Model.Filters.Department)">@item</option> }</select></div>
                    <div class="col-md-2"><label for="category" class="form-label">Category</label><select id="category" name="Category" class="form-select"><option value="">All categories</option>@foreach (var item in Model.Categories) { <option value="@item" selected="@(item == Model.Filters.Category)">@item</option> }</select></div>
                    <div class="col-md-2"><label for="status" class="form-label">Status</label><select id="status" name="Status" class="form-select"><option value="">All statuses</option>@foreach (var item in Model.Statuses) { <option value="@item.Value" selected="@(item.Value == Model.Filters.Status)">@item.Text</option> }</select></div>
                    <div class="col-md-2 d-flex align-items-end gap-2"><button type="submit" class="btn btn-primary flex-fill">Apply</button><a asp-controller="Report" asp-action="Index" class="btn btn-outline-secondary">Clear</a></div>
                </div>
            </form>
        </div>
    </section>

    <div class="row row-cards mb-4">
        <div class="col-sm-6 col-xl-3"><div class="card"><div class="card-body"><div class="text-muted">Total ideas</div><div class="h1 mb-0">@Model.ReportSummary.TotalIdeas</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card"><div class="card-body"><div class="text-muted">Approved</div><div class="h1 text-success mb-0">@Model.ReportSummary.Approved</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card"><div class="card-body"><div class="text-muted">Under review</div><div class="h1 text-warning mb-0">@Model.ReportSummary.UnderReview</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card"><div class="card-body"><div class="text-muted">Declined</div><div class="h1 text-danger mb-0">@Model.ReportSummary.Declined</div></div></div></div>
    </div>

    <div class="row row-cards mb-4">
        <div class="col-lg-6"><section class="card h-100"><div class="card-header"><h3 class="card-title">Ideas by category</h3></div><div class="list-group list-group-flush">@for (var i = 0; i < Model.CategoryChartLabels.Count; i++) { <div class="list-group-item d-flex justify-content-between"><span>@Model.CategoryChartLabels[i]</span><strong>@Model.CategoryChartData[i]</strong></div> }</div></section></div>
        <div class="col-lg-6"><section class="card h-100"><div class="card-header"><h3 class="card-title">Monthly submissions</h3></div><div class="list-group list-group-flush">@for (var i = 0; i < Model.TrendChartLabels.Count; i++) { <div class="list-group-item d-flex justify-content-between"><span>@Model.TrendChartLabels[i]</span><strong>@Model.TrendChartData[i]</strong></div> }</div></section></div>
    </div>

    <section class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title">Detailed report</h3>
            <div class="d-flex gap-2">
                <a asp-controller="Report" asp-action="Export" asp-route-format="xlsx" asp-route-startDate="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" asp-route-department="@Model.Filters.Department" asp-route-category="@Model.Filters.Category" asp-route-status="@Model.Filters.Status" class="btn btn-outline-primary btn-sm">Export Excel</a>
                <a asp-controller="Report" asp-action="Export" asp-route-format="csv" asp-route-startDate="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" asp-route-department="@Model.Filters.Department" asp-route-category="@Model.Filters.Category" asp-route-status="@Model.Filters.Status" class="btn btn-outline-secondary btn-sm">Export CSV</a>
            </div>
        </div>
        <div class="table-responsive table-responsive-container">
            <table class="table table-vcenter card-table responsive-table"><thead><tr><th>Idea</th><th>Submitter</th><th>Department</th><th>Category</th><th>Status</th><th>Date</th></tr></thead><tbody>
            @if (Model.ReportIdeas.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-5">No ideas match these filters.</td></tr> }
            @foreach (var idea in Model.ReportIdeas) { <tr><td>@idea.Title</td><td>@idea.Submitter</td><td>@idea.Department</td><td>@idea.Category</td><td><span class="badge bg-secondary-lt">@idea.Status</span></td><td>@idea.Date.ToString("dd MMM yyyy")</td></tr> }
        </tbody></table></div>
        @if (Model.TotalPages > 1) { <div class="card-footer"><nav class="d-flex justify-content-center gap-1">@for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++) { <a asp-controller="Report" asp-action="Index" asp-route-page="@pageNumber" asp-route-startDate="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" asp-route-department="@Model.Filters.Department" asp-route-category="@Model.Filters.Category" asp-route-status="@Model.Filters.Status" class="btn btn-sm @(pageNumber == Model.CurrentPage ? "btn-primary" : "btn-outline-secondary")">@pageNumber</a> }</nav></div> }
    </section>
</div>
