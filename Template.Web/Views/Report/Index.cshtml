@model ReportsModel
@{
    ViewData["Title"] = "Reports";
    string BadgeClass(string? value) => (value ?? "unknown").Replace(" ", "-").ToLowerInvariant();
    var maxCategoryCount = Math.Max(1, Model.CategoryChartData.DefaultIfEmpty(0).Max());
    var maxTrendCount = Math.Max(1, Model.TrendChartData.DefaultIfEmpty(0).Max());
    var hasFilters = Model.Filters.StartDate.HasValue ||
        Model.Filters.EndDate.HasValue ||
        !string.IsNullOrWhiteSpace(Model.Filters.Department) ||
        !string.IsNullOrWhiteSpace(Model.Filters.Category) ||
        !string.IsNullOrWhiteSpace(Model.Filters.Status);
}

<div class="prototype-heading">
    <div>
        <h1>Idea reports</h1>
        <p>Generate a live report, review category and monthly trends, then export the same filtered results.</p>
    </div>
</div>

<section class="prototype-card report-filter-card">
    <div class="ims-staff-section-header">
        <h2>Report filters</h2>
        @if (hasFilters)
        {
            <a asp-action="Index" class="prototype-button secondary">Clear filters</a>
        }
    </div>
    <form method="get" asp-controller="Report" asp-action="Index" class="report-filter-grid" data-loading>
        <div>
            <label for="startDate">From date</label>
            <input id="startDate" name="startDate" type="date" value="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="endDate">To date</label>
            <input id="endDate" name="endDate" type="date" value="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="department">Department</label>
            <select id="department" name="department">
                <option value="">All departments</option>
                @foreach (var department in Model.Departments)
                {
                    <option value="@department" selected="@(department == Model.Filters.Department ? "selected" : null)">@department</option>
                }
            </select>
        </div>
        <div>
            <label for="category">Idea category</label>
            <select id="category" name="category">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(category == Model.Filters.Category ? "selected" : null)">@category</option>
                }
            </select>
        </div>
        <div>
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="">All statuses</option>
                <option value="PendingInformation" selected="@(Model.Filters.Status is "PendingInformation" or "Pending Information" ? "selected" : null)">Pending Information</option>
                <option value="UnderReview" selected="@(Model.Filters.Status is "UnderReview" or "Under Review" ? "selected" : null)">Under Review</option>
                <option value="Approved" selected="@(Model.Filters.Status == "Approved" ? "selected" : null)">Approved</option>
                <option value="Declined" selected="@(Model.Filters.Status == "Declined" ? "selected" : null)">Declined</option>
            </select>
        </div>
        <button type="submit" class="prototype-button report-generate-button">
            <i class="ti ti-report"></i>
            Generate report
        </button>
    </form>
</section>

@if (hasFilters)
{
    <div class="prototype-alert success" role="status">
        <i class="ti ti-circle-check"></i>
        <span>Report generated with @Model.ReportSummary.TotalIdeas matching idea(s).</span>
    </div>
}

<section class="report-summary-grid" aria-label="Report summary">
    <article class="prototype-card report-summary-card">
        <small>Total ideas</small>
        <strong>@Model.ReportSummary.TotalIdeas</strong>
    </article>
    <article class="prototype-card report-summary-card approved">
        <small>Approved</small>
        <strong>@Model.ReportSummary.Approved</strong>
    </article>
    <article class="prototype-card report-summary-card review">
        <small>Under review</small>
        <strong>@Model.ReportSummary.UnderReview</strong>
    </article>
    <article class="prototype-card report-summary-card declined">
        <small>Declined</small>
        <strong>@Model.ReportSummary.Declined</strong>
    </article>
</section>

<section class="report-chart-grid">
    <article class="prototype-card">
        <div class="report-card-heading">
            <div>
                <h2>Ideas by category</h2>
                <p>Distribution of ideas in the generated report.</p>
            </div>
            <i class="ti ti-category"></i>
        </div>
        @if (Model.CategoryChartLabels.Count == 0)
        {
            <div class="report-empty">No category data matches these filters.</div>
        }
        else
        {
            <div class="report-category-chart">
                @for (var index = 0; index < Model.CategoryChartLabels.Count; index++)
                {
                    var count = Model.CategoryChartData[index];
                    var width = Math.Max(4, count * 100 / maxCategoryCount);
                    <div class="report-bar-row">
                        <div><span>@Model.CategoryChartLabels[index]</span><strong>@count</strong></div>
                        <span class="report-bar-track"><span style="width:@width%"></span></span>
                    </div>
                }
            </div>
        }
    </article>

    <article class="prototype-card">
        <div class="report-card-heading">
            <div>
                <h2>Monthly submission trend</h2>
                <p>Ideas received each month in the selected period.</p>
            </div>
            <i class="ti ti-chart-bar"></i>
        </div>
        @if (Model.TrendChartLabels.Count == 0)
        {
            <div class="report-empty">No monthly data matches these filters.</div>
        }
        else
        {
            <div class="report-trend-chart" aria-label="Monthly submission trend">
                @for (var index = 0; index < Model.TrendChartLabels.Count; index++)
                {
                    var count = Model.TrendChartData[index];
                    var height = Math.Max(8, count * 100 / maxTrendCount);
                    <div class="report-trend-column">
                        <strong>@count</strong>
                        <span class="report-trend-bar"><span style="height:@height%"></span></span>
                        <small>@Model.TrendChartLabels[index]</small>
                    </div>
                }
            </div>
        }
    </article>
</section>

<section class="prototype-card report-detail-card">
    <div class="report-card-heading report-detail-heading">
        <div>
            <h2>Detailed report</h2>
            <p>@Model.ReportSummary.TotalIdeas idea(s) match the current report filters.</p>
        </div>
        <form asp-controller="Report" asp-action="Export" method="get" class="report-export-actions">
            <input type="hidden" name="startDate" value="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="endDate" value="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="department" value="@Model.Filters.Department" />
            <input type="hidden" name="category" value="@Model.Filters.Category" />
            <input type="hidden" name="status" value="@Model.Filters.Status" />
            <button type="submit" name="format" value="excel" class="prototype-button secondary"><i class="ti ti-file-spreadsheet"></i>Excel</button>
            <button type="submit" name="format" value="pdf" class="prototype-button secondary"><i class="ti ti-file-type-pdf"></i>PDF</button>
            <button type="submit" name="format" value="csv" class="prototype-button secondary"><i class="ti ti-download"></i>CSV</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter">
            <thead>
                <tr>
                    <th>Idea title</th>
                    <th>Submitter</th>
                    <th>Department</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ReportIdeas.Count == 0)
                {
                    <tr><td colspan="6" class="report-empty">No ideas match the selected filters.</td></tr>
                }
                @foreach (var idea in Model.ReportIdeas)
                {
                    <tr>
                        <td><strong>@idea.Title</strong></td>
                        <td>@idea.Submitter</td>
                        <td>@idea.Department</td>
                        <td>@(string.IsNullOrWhiteSpace(idea.Category) ? "Uncategorised" : idea.Category)</td>
                        <td><span class="ims-staff-badge ims-staff-badge-@BadgeClass(idea.Status)">@idea.Status</span></td>
                        <td>@idea.Date.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="ims-staff-pagination" aria-label="Report pages">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <a asp-action="Index"
                   asp-route-page="@pageNumber"
                   asp-route-startDate="@Model.Filters.StartDate?.ToString("yyyy-MM-dd")"
                   asp-route-endDate="@Model.Filters.EndDate?.ToString("yyyy-MM-dd")"
                   asp-route-department="@Model.Filters.Department"
                   asp-route-category="@Model.Filters.Category"
                   asp-route-status="@Model.Filters.Status"
                   class="ims-staff-pagination-link @(pageNumber == Model.CurrentPage ? "ims-staff-pagination-active" : "")">@pageNumber</a>
            }
        </nav>
    }
</section>
