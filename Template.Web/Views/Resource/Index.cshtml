@model ResourcesModel
@{
    ViewData["Title"] = "Resources";
    var canManage = User.IsInRole(RoleConstants.ItAdmin) || User.IsInRole(RoleConstants.InnovationTeam);

    string CategoryName(ResourceCategory category) => category switch
    {
        ResourceCategory.InnovationStrategy => "Innovation Strategy",
        ResourceCategory.PolicyAndGuidelines => "Policy & Guidelines",
        ResourceCategory.TrainingMaterial => "Training Material",
        _ => category.ToString()
    };

    string FileSize(long bytes) => bytes switch
    {
        >= 1_048_576 => $"{bytes / 1_048_576d:0.0} MB",
        >= 1_024 => $"{bytes / 1_024d:0.0} KB",
        _ => $"{bytes} B"
    };
}

<div class="prototype-heading">
    <div>
        <h1>Resource library</h1>
        <p>Access innovation strategies, policies, templates, and training materials.</p>
    </div>
</div>

@if (canManage)
{
    <details class="prototype-card resource-upload-card">
        <summary>
            <span><i class="ti ti-cloud-upload"></i>Upload a resource</span>
            <i class="ti ti-chevron-down" aria-hidden="true"></i>
        </summary>
        <form asp-controller="Resource" asp-action="Upload" method="post" enctype="multipart/form-data" data-loading>
            <div>
                <label for="ResourceTitle">Resource title *</label>
                <input id="ResourceTitle" name="ResourceTitle" required maxlength="200" placeholder="Enter a clear resource title" />
            </div>
            <div>
                <label for="ResourceCategory">Category *</label>
                <select id="ResourceCategory" name="Category" asp-items="Html.GetEnumSelectList<ResourceCategory>()"></select>
            </div>
            <div class="resource-description-input">
                <label for="ResourceDescription">Description</label>
                <input id="ResourceDescription" name="Description" maxlength="1000" placeholder="Briefly describe this resource" />
            </div>
            <div class="resource-file-input">
                <label for="ResourceFile">Document *</label>
                <input id="ResourceFile" name="File" type="file" accept=".pdf,.docx" required />
            </div>
            <button class="prototype-button" type="submit"><i class="ti ti-upload"></i>Upload resource</button>
        </form>
    </details>
}

<form method="get" asp-controller="Resource" asp-action="Index" class="prototype-card resource-filters">
    <label class="resource-search">
        <span class="visually-hidden">Search resources</span>
        <i class="ti ti-search" aria-hidden="true"></i>
        <input type="search" asp-for="SearchTerm" placeholder="Search resources" />
    </label>
    <label>
        <span class="visually-hidden">Filter by category</span>
        <select asp-for="CategoryFilter" asp-items="Html.GetEnumSelectList<ResourceCategory>()">
            <option value="">All categories</option>
        </select>
    </label>
    <button type="submit" class="prototype-button"><i class="ti ti-adjustments"></i>Apply</button>
    <a asp-action="Index" class="prototype-button secondary">Clear</a>
</form>

@if (Model.Resources.Count == 0)
{
    <div class="prototype-card admin-empty-state">
        <i class="ti ti-books-off"></i>
        <h2>No resources found</h2>
        <p>Change the search filters or upload a new document.</p>
    </div>
}
else
{
    <div class="resource-card-grid">
        @foreach (var resource in Model.Resources)
        {
            <article class="prototype-card resource-library-card">
                <header>
                    <span class="resource-document-icon"><i class="ti ti-file-text"></i></span>
                    <span class="resource-category">@CategoryName(resource.Category)</span>
                </header>
                <div>
                    <h2>@resource.ResourceTitle</h2>
                    <p>@(string.IsNullOrWhiteSpace(resource.Description) ? "No description provided." : resource.Description)</p>
                </div>
                <dl>
                    <div><dt><i class="ti ti-paperclip"></i><span class="visually-hidden">File</span></dt><dd>@resource.FileName</dd></div>
                    <div><dt><i class="ti ti-database"></i><span class="visually-hidden">Size</span></dt><dd>@FileSize(resource.FileSizeBytes)</dd></div>
                    <div><dt><i class="ti ti-calendar"></i><span class="visually-hidden">Uploaded</span></dt><dd>@resource.UploadedAt.ToString("dd MMM yyyy")</dd></div>
                    <div><dt><i class="ti ti-download"></i><span class="visually-hidden">Downloads</span></dt><dd>@resource.DownloadCount download(s)</dd></div>
                </dl>
                <footer>
                    <a asp-controller="Resource" asp-action="Download" asp-route-id="@resource.Id" asp-route-inline="true"
                       class="prototype-button"><i class="ti ti-eye"></i>View</a>
                    <a asp-controller="Resource" asp-action="Download" asp-route-id="@resource.Id"
                       class="prototype-button secondary"><i class="ti ti-download"></i>Download</a>
                    @if (canManage)
                    {
                        <form asp-controller="Resource" asp-action="Deactivate" method="post" data-loading>
                            <input type="hidden" name="id" value="@resource.Id" />
                            <button type="submit" class="prototype-button secondary resource-delete-action"
                                    data-confirm="Delete @resource.ResourceTitle from the resource library?">
                                <i class="ti ti-trash"></i>Delete
                            </button>
                        </form>
                    }
                </footer>
            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Resource pages" class="category-pagination">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <a asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryFilter="@Model.CategoryFilter"
                   asp-route-page="@pageNumber"
                   class="@(pageNumber == Model.CurrentPage ? "active" : "")">
                    @pageNumber
                </a>
            }
        </nav>
    }
}
