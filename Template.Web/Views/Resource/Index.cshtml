@model ResourcesModel
@{
    ViewData["Title"] = "Resources";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Resource Library</h3>
    </div>
    <div class="card-body">
        <form method="get" asp-controller="Resource" asp-action="Index" class="row g-2 mb-4">
            <div class="col-auto flex-grow-1">
                <input type="text" class="form-control" placeholder="Search resources..." asp-for="SearchTerm">
            </div>
            <div class="col-auto">
                <select class="form-select" asp-for="CategoryFilter" asp-items="Html.GetEnumSelectList<ResourceCategory>()">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </div>
        </form>

        @if (Model.Resources.Any())
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
                @foreach (var resource in Model.Resources)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <div class="mb-3"><i class="ti ti-file-text" style="font-size:2rem;color:#888;"></i></div>
                                <h5 class="card-title">@resource.ResourceTitle</h5>
                                <p class="card-text text-muted small">@resource.Description</p>
                                <div class="text-muted small mb-3">Uploaded: @resource.UploadedAt.ToString("dd MMM yyyy")</div>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-controller="Resource" asp-action="Download" asp-route-id="@resource.Id" asp-route-inline="true" class="btn btn-sm btn-outline-primary">View</a>
                                    <a asp-controller="Resource" asp-action="Download" asp-route-id="@resource.Id" class="btn btn-sm btn-outline-secondary">Download</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav>
                        <ul class="pagination">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Resource" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">&laquo; Previous</a>
                                </li>
                            }
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-controller="Resource" asp-action="Index" asp-route-page="@i">@i</a>
                                </li>
                            }
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Resource" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Next &raquo;</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="ti ti-books" style="font-size:3rem;color:#ccc;"></i>
                <h4 class="mt-3">No resources found</h4>
                <p class="text-muted">Try adjusting your search or filter criteria.</p>
            </div>
        }
    </div>
</div>