@{ ViewData["Title"] = "Help & Support"; }
<div class="prototype-heading"><div><h1>Help & support</h1><p>Quick guidance for common tasks in the Innovation Management System.</p></div></div>
<div class="prototype-grid">
    <a class="prototype-card prototype-settings-card" asp-controller="Idea" asp-action="Submit"><i class="ti ti-bulb"></i><strong>Submit an idea</strong><span>Start a new innovation proposal.</span></a>
    <a class="prototype-card prototype-settings-card" asp-controller="Resource" asp-action="Index"><i class="ti ti-books"></i><strong>Resources</strong><span>Browse guidance and reference materials.</span></a>
    <a class="prototype-card prototype-settings-card" asp-controller="Notification" asp-action="Index"><i class="ti ti-bell"></i><strong>Notifications</strong><span>Review updates and requested actions.</span></a>
    <a class="prototype-card prototype-settings-card" asp-controller="Profile" asp-action="Index"><i class="ti ti-user-circle"></i><strong>Your profile</strong><span>Review your account details.</span></a>
</div>
