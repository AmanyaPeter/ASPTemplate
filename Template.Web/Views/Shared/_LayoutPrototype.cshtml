@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject Template.Data.Configurations.ApplicationDbContext LayoutDb
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAdmin = User.IsInRole("Admin");
    var isTeam = User.IsInRole("InnovationTeam");
    string Active(string name, string? actionName = null) =>
        controller.Equals(name, StringComparison.OrdinalIgnoreCase) &&
        (actionName == null || action.Equals(actionName, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : "";
    var userIdValue = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var hasLayoutUserId = Guid.TryParse(userIdValue, out var layoutUserId);
    var storedFullName = hasLayoutUserId
        ? await LayoutDb.Users.AsNoTracking()
            .Where(user => user.Id == layoutUserId)
            .Select(user => user.FullName)
            .SingleOrDefaultAsync()
        : null;
    var displayName = !string.IsNullOrWhiteSpace(storedFullName)
        ? storedFullName
        : !string.IsNullOrWhiteSpace(User.Identity?.Name)
            ? User.Identity!.Name!
            : "User";
    var roleDisplayName = isAdmin ? "Administrator" : isTeam ? "Innovation Team" : "Staff";
    var unreadNotificationCount = hasLayoutUserId
        ? await LayoutDb.Notifications.AsNoTracking()
            .CountAsync(notification => notification.UserId == layoutUserId && !notification.IsRead)
        : 0;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BOU Innovation</title>
    <link rel="stylesheet" href="~/css/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/webfont/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/adminpages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prototype.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workflow-enhancements.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="prototype-shell">
    <div class="prototype-overlay" data-sidebar-close></div>
    <aside class="prototype-sidebar" id="prototype-sidebar">
        <a class="prototype-brand" asp-controller="Home" asp-action="Index">
            <span class="prototype-brand-mark"><img src="~/img/bou.png" alt="Bank of Uganda" /></span>
            <span><strong>Innovation</strong><small>Management System</small></span>
        </a>
        <nav class="prototype-nav">
            <a class="@Active("Home")" asp-controller="Home" asp-action="Index">
                <span class="prototype-nav-icon" aria-hidden="true"><i class="ti ti-home"></i></span>
                <span>Dashboard</span>
            </a>
            @if (!isAdmin && !isTeam)
            {
                <a class="@Active("Idea", "Submit")" asp-controller="Idea" asp-action="Submit">
                    <span class="prototype-nav-icon" aria-hidden="true"><i class="ti ti-sparkles"></i></span>
                    <span>Submit an idea</span>
                </a>
                <a class="@Active("Idea", "MyIdeas")" asp-controller="Idea" asp-action="MyIdeas">
                    <span class="prototype-nav-icon" aria-hidden="true"><i class="ti ti-clipboard-list"></i></span>
                    <span>My ideas</span>
                </a>
            }
            @if (isAdmin || isTeam)
            {
                @if (isTeam)
                {
                    <a class="@Active("Idea")" asp-controller="Idea" asp-action="Pipeline"><i class="ti ti-bulb-filled"></i>Idea pipeline</a>
                }
                <a class="@Active("Category")" asp-controller="Category" asp-action="Index"><i class="ti ti-category"></i>Categories</a>
                <a class="@Active("Report")" asp-controller="Report" asp-action="Index"><i class="ti ti-chart-bar"></i>Reports</a>
            }
            <a class="@Active("Resource")" asp-controller="Resource" asp-action="Index">
                <span class="prototype-nav-icon" aria-hidden="true"><i class="ti ti-books"></i></span>
                <span>Resources</span>
            </a>
            <a class="@Active("Notification")" asp-controller="Notification" asp-action="Index">
                <span class="prototype-nav-icon" aria-hidden="true"><i class="ti ti-bell"></i></span>
                <span>Notifications</span>
                <span class="prototype-nav-badge @(unreadNotificationCount == 0 ? "d-none" : "")" data-notification-count>@unreadNotificationCount</span>
            </a>
            @if (isAdmin)
            {
                <span class="prototype-nav-label">Administration</span>
                <a class="@Active("Account", "Index")" asp-controller="Account" asp-action="Index"><i class="ti ti-users"></i>User accounts</a>
                <a class="@Active("Account", "Create")" asp-controller="Account" asp-action="Create"><i class="ti ti-user-plus"></i>Create user</a>
                <a class="@Active("Role")" asp-controller="Role" asp-action="Index"><i class="ti ti-shield-lock"></i>Roles & permissions</a>
                <a class="@Active("AuditLog")" asp-controller="AuditLog" asp-action="Index"><i class="ti ti-history"></i>Audit logs</a>
                <a class="@Active("Settings", "Index")" asp-controller="Settings" asp-action="Index"><i class="ti ti-settings"></i>System settings</a>
            }
            <a class="@Active("Settings", "Support")" asp-controller="Settings" asp-action="Support">
                <span class="prototype-nav-icon" aria-hidden="true"><i class="ti ti-lifebuoy"></i></span>
                <span>Help &amp; support</span>
            </a>
        </nav>
        <div class="prototype-sidebar-foot">
            <a class="prototype-sidebar-profile" asp-controller="Profile" asp-action="Index"><i class="ti ti-user-circle"></i><span>@displayName<small>@roleDisplayName</small></span></a>
            <a class="prototype-sidebar-logout" asp-controller="Account" asp-action="Logout" title="Sign out and return to login">
                <span class="prototype-nav-icon" aria-hidden="true"><i class="ti ti-power"></i></span>
                <span>Log out</span>
            </a>
        </div>
    </aside>
    <div class="prototype-page">
        <header class="prototype-topbar">
            <button class="prototype-icon-button prototype-menu" type="button" data-sidebar-open aria-label="Open menu"><i class="ti ti-menu-2"></i></button>
            <a class="prototype-header-logo" asp-controller="Home" asp-action="Index" aria-label="Bank of Uganda dashboard">
                <img src="~/img/bou.png" alt="Bank of Uganda coat of arms" />
            </a>
            <div class="prototype-topbar-title"><small>Bank of Uganda</small><strong>@(ViewData["Title"] ?? "Innovation Management")</strong></div>
            <div class="prototype-top-actions">
                <a class="prototype-icon-button prototype-notification-link" asp-controller="Notification" asp-action="Index"
                   aria-label="Notifications, @unreadNotificationCount unread">
                    <i class="ti ti-bell"></i>
                    <span class="prototype-notification-badge @(unreadNotificationCount == 0 ? "d-none" : "")" data-notification-count>@unreadNotificationCount</span>
                </a>
                <a class="prototype-user-profile" asp-controller="Profile" asp-action="Index"
                   aria-label="Open profile for @displayName, @roleDisplayName"
                   title="@displayName – @roleDisplayName">
                    <span class="prototype-avatar" aria-hidden="true">@displayName.Substring(0, 1).ToUpperInvariant()</span>
                    <span class="prototype-user-label">@displayName <span aria-hidden="true">–</span> @roleDisplayName</span>
                </a>
                <a class="prototype-logout" asp-controller="Account" asp-action="Logout" title="Sign out and return to login">
                    <i class="ti ti-power"></i>
                    <span>Log out</span>
                </a>
            </div>
        </header>
        <main class="prototype-content">
            @if (TempData["SuccessMessage"] is string success)
            {
                <div class="prototype-alert success" role="alert"><i class="ti ti-circle-check"></i><span>@success</span><button type="button" data-alert-close>&times;</button></div>
            }
            @if (TempData["ErrorMessage"] is string error)
            {
                <div class="prototype-alert danger" role="alert"><i class="ti ti-alert-circle"></i><span>@error</span><button type="button" data-alert-close>&times;</button></div>
            }
            @RenderBody()
        </main>
        <footer class="prototype-footer">BOU Innovation Management System · Working prototype</footer>
    </div>
    @if (TempData["IdeaSubmissionSuccess"] is string submissionSuccess)
    {
        <div class="prototype-popup-backdrop" data-popup role="presentation">
            <section class="prototype-popup" role="dialog" aria-modal="true" aria-labelledby="idea-submission-popup-title">
                <span class="prototype-popup-icon"><i class="ti ti-circle-check"></i></span>
                <h2 id="idea-submission-popup-title">Idea submitted</h2>
                <p>@submissionSuccess</p>
                <button type="button" class="prototype-button" data-popup-close autofocus>Continue</button>
            </section>
        </div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/tabler.min.js" asp-append-version="true"></script>
    <script src="~/js/prototype.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
