@page
@model ActivityLogModel
@{
    ViewData["Title"] = "Activity Log - Innovation Management System";
}

<body class="ims-staff-dashboard">
    <!-- Sidebar -->
    <aside class="ims-staff-sidebar">
        <div class="ims-staff-sidebar-brand">
            <div class="ims-staff-brand-logo"><img src="~/boulogo.ico" alt="BOU"></div>
            <div class="ims-staff-brand-text">Bank of Uganda<span>Innovation Management</span></div>
        </div>
        <ul class="ims-staff-sidebar-nav">
            <li><a asp-page="/Admin/Dashboard"><span class="ims-staff-nav-icon"><i data-lucide="layout-dashboard" style="width:18px;height:18px;"></i></span><span>Dashboard</span></a></li>
            <li><a asp-page="/Admin/Users"><span class="ims-staff-nav-icon"><i data-lucide="users" style="width:18px;height:18px;"></i></span><span>Users</span></a></li>
            <li><a asp-page="/Admin/ActivityLog" class="ims-staff-nav-active"><span class="ims-staff-nav-icon"><i data-lucide="book-open" style="width:18px;height:18px;"></i></span><span>Activity Log</span></a></li>
            <li><a asp-page="/Admin/Profile"><span class="ims-staff-nav-icon"><i data-lucide="user" style="width:18px;height:18px;"></i></span><span>Profile</span></a></li>
        </ul>
        <div class="ims-staff-sidebar-footer">BOU Innovation System v1.0</div>
    </aside>

    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
        <!-- Header -->
        <header class="ims-staff-top-header">
            <div class="ims-staff-header-left">
                <h2>Activity Log</h2>
            </div>
            <div class="ims-staff-header-right">
                <button class="ims-staff-notification-btn"><i data-lucide="bell" style="width:20px;height:20px;"></i><span class="ims-staff-badge-dot"></span></button>
                <div class="ims-staff-user-profile">
                    <div class="ims-staff-avatar">@User.Identity.Name?.Substring(0, 1)</div>
                    <span class="ims-staff-user-name">@User.Identity.Name</span>
                </div>
                <button class="ims-staff-logout-btn">Log out</button>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <!-- Filters Bar -->
            <div class="ims-staff-filters-bar">
                <input type="text" class="ims-staff-form-control ims-staff-search-input" placeholder="Search by user or action..." asp-for="SearchTerm">
                <input type="date" class="ims-staff-form-control" asp-for="FilterDate" style="min-width:auto;">
                <select class="ims-staff-form-control" asp-for="StatusFilter" style="min-width:120px;">
                    <option value="">All Statuses</option>
                    <option value="Success">Success</option>
                    <option value="Failed">Failed</option>
                    <option value="Blocked">Blocked</option>
                </select>
                <button class="ims-staff-btn ims-staff-btn-secondary ims-staff-export-btn" onclick="exportData()">
                    <i data-lucide="download" style="width:16px;height:16px;"></i> Export
                </button>
            </div>

            <!-- Activity Table -->
            <div class="ims-staff-card ims-staff-table-card">
                <div class="ims-staff-table-container">
                    <table class="ims-staff-data-table">
                        <thead>
                            <tr>
                                <th>Date/Time</th>
                                <th>User</th>
                                <th>Action</th>
                                <th>Module</th>
                                <th>IP Address</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var activity in Model.Activities)
                            {
                                <tr>
                                    <td>@activity.DateTime.ToString("dd MMM yyyy, HH:mm:ss")</td>
                                    <td>@activity.User</td>
                                    <td>@activity.Action</td>
                                    <td>@activity.Module</td>
                                    <td>@activity.IPAddress</td>
                                    <td>
                                        <span class="ims-staff-badge ims-staff-badge-@activity.Status.ToLower()">
                                            @activity.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="ims-staff-pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-page="/Admin/ActivityLog" asp-route-page="@(Model.CurrentPage - 1)" class="ims-staff-pagination-link">&laquo; Previous</a>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-page="/Admin/ActivityLog" asp-route-page="@i" class="ims-staff-pagination-link @(i == Model.CurrentPage ? "ims-staff-pagination-active" : "")">@i</a>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-page="/Admin/ActivityLog" asp-route-page="@(Model.CurrentPage + 1)" class="ims-staff-pagination-link">Next &raquo;</a>
                        }
                    </div>
                }
            </div>
        </main>
    </div>

    @section Scripts {
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            lucide.createIcons();

            function exportData() {
                // Export data to CSV
                const table = document.querySelector('.ims-staff-data-table');
                const rows = table.querySelectorAll('tr');
                let csv = [];
                
                // Headers
                const headers = [];
                table.querySelectorAll('thead th').forEach(th => {
                    headers.push(th.textContent.trim());
                });
                csv.push(headers.join(','));

                // Data
                table.querySelectorAll('tbody tr').forEach(row => {
                    const rowData = [];
                    row.querySelectorAll('td').forEach(td => {
                        // Clean up badge text
                        let text = td.textContent.trim();
                        if (td.querySelector('.ims-staff-badge')) {
                            text = td.querySelector('.ims-staff-badge').textContent.trim();
                        }
                        rowData.push(`"${text}"`);
                    });
                    csv.push(rowData.join(','));
                });

                // Download
                const blob = new Blob([csv.join('\n')], { type: 'text/csv' });
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `activity-log-${new Date().toISOString().split('T')[0]}.csv`;
                a.click();
                window.URL.revokeObjectURL(url);
            }
        </script>
    }
</body>