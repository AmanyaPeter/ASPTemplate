    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
        <!-- Header -->
        <header class="ims-staff-top-header">
            <div class="ims-staff-header-left">
                <h2>Idea Details</h2>
            </div>
            <div class="ims-staff-header-right">
                <button class="ims-staff-notification-btn"><i data-lucide="bell" style="width:20px;height:20px;"></i><span class="ims-staff-badge-dot"></span></button>
                <div class="ims-staff-user-profile">
                    <div class="ims-staff-avatar">B</div>
                    <span class="ims-staff-user-name">Brian</span>
                </div>
                <button class="ims-staff-logout-btn">Log out</button>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <!-- Back Button -->
            <div class="ims-staff-back-link">
                <a href="my-ideas.html" class="ims-staff-back-link-anchor">&larr; Back to My Ideas</a>
            </div>

            <!-- Detail Grid -->
            <div class="ims-staff-detail-grid">
                <!-- Left Column -->
                <div>
                    <!-- Idea Details Card -->
                    <div class="ims-staff-card">
                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-title">Digital Currency Wallet</h3>
                            <p class="ims-staff-detail-meta">Submitted on 10 Jul 2025 by Brian Ssempijja</p>
                            <div class="ims-staff-detail-badges">
                                <span class="ims-staff-badge ims-staff-badge-under-review">Under Review</span>
                                <span class="ims-staff-badge ims-staff-badge-concept">Concept Development</span>
                            </div>
                        </div>

                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-section-title">Description</h3>
                            <p class="ims-staff-detail-text">A digital currency wallet solution that allows BOU staff and customers to securely store, send and receive digital currencies. The solution will integrate with existing banking infrastructure and provide a seamless user experience.</p>
                        </div>

                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-section-title">Problem Statement</h3>
                            <p class="ims-staff-detail-text">Current payment systems are slow and expensive for cross-border transactions. There is no unified digital currency platform that serves both staff and customers efficiently.</p>
                        </div>

                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-section-title">Proposed Solution</h3>
                            <p class="ims-staff-detail-text">Develop a multi-currency digital wallet with blockchain-based settlement, mobile app integration, and real-time currency conversion. The solution will leverage existing BOU infrastructure and comply with regulatory requirements.</p>
                        </div>

                        <div class="ims-staff-detail-section">
                            <h3 class="ims-staff-detail-section-title">Attachments</h3>
                            <div class="ims-staff-attachment-list">
                                <span class="ims-staff-attachment-item"><i data-lucide="file-text" style="width:14px;height:14px;vertical-align:middle;"></i> proposal_v2.pdf</span>
                                <span class="ims-staff-attachment-item"><i data-lucide="bar-chart-3" style="width:14px;height:14px;vertical-align:middle;"></i> budget_estimate.xlsx</span>
                                <span class="ims-staff-attachment-item"><i data-lucide="image" style="width:14px;height:14px;vertical-align:middle;"></i> ui_mockup.png</span>
                            </div>
                        </div>
                    </div>

                    <!-- Comments Card -->
                    <div class="ims-staff-card">
                        <div class="ims-staff-section-header">
                            <h3>Comments</h3>
                        </div>
                        <div class="ims-staff-comment-thread">
                            <div class="ims-staff-comment-item">
                                <div class="ims-staff-comment-avatar">JM</div>
                                <div class="ims-staff-comment-body">
                                    <span class="ims-staff-comment-author">Jane Mukasa</span>
                                    <span class="ims-staff-comment-meta">Innovation Team &middot; 2 days ago</span>
                                    <div class="ims-staff-comment-text">Great proposal. Please provide more details on the security architecture and how you plan to handle KYC compliance.</div>
                                </div>
                            </div>
                            <div class="ims-staff-comment-item">
                                <div class="ims-staff-comment-avatar">B</div>
                                <div class="ims-staff-comment-body">
                                    <span class="ims-staff-comment-author">Brian Ssempijja</span>
                                    <span class="ims-staff-comment-meta">1 day ago</span>
                                    <div class="ims-staff-comment-text">Thank you for the feedback. I will upload an updated document with the security details by end of week.</div>
                                </div>
                            </div>
                            <div class="ims-staff-comment-item">
                                <div class="ims-staff-comment-avatar">PK</div>
                                <div class="ims-staff-comment-body">
                                    <span class="ims-staff-comment-author">Peter Kaggwa</span>
                                    <span class="ims-staff-comment-meta">Innovation Team &middot; 5 hours ago</span>
                                    <div class="ims-staff-comment-text">Please also include a cost-benefit analysis in your updated submission.</div>
                                </div>
                            </div>
                        </div>
                        <div class="ims-staff-comment-box">
                            <div class="ims-staff-comment-box-avatar">B</div>
                            <textarea class="ims-staff-form-control" rows="2" placeholder="Write a comment..."></textarea>
                            <button class="ims-staff-btn ims-staff-btn-primary ims-staff-btn-sm ims-staff-comment-submit-btn">Send</button>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div>
                    <!-- Progress Tracker Card -->
                    <div class="ims-staff-card">
                        <div class="ims-staff-section-header">
                            <h3>Progress Tracker</h3>
                        </div>
                        <div class="ims-staff-progress-tracker">
                            <div class="ims-staff-stage-item ims-staff-stage-completed">
                                <div class="ims-staff-stage-dot"></div>
                                <div class="ims-staff-stage-name">Submitted</div>
                            </div>
                            <div class="ims-staff-stage-item ims-staff-stage-active">
                                <div class="ims-staff-stage-dot"></div>
                                <div class="ims-staff-stage-name">Concept Development</div>
                            </div>
                            <div class="ims-staff-stage-item">
                                <div class="ims-staff-stage-dot"></div>
                                <div class="ims-staff-stage-name">Experimentation</div>
                            </div>
                            <div class="ims-staff-stage-item">
                                <div class="ims-staff-stage-dot"></div>
                                <div class="ims-staff-stage-name">Deployment</div>
                            </div>
                            <div class="ims-staff-stage-item">
                                <div class="ims-staff-stage-dot"></div>
                                <div class="ims-staff-stage-name">Closed</div>
                            </div>
                        </div>
                    </div>

                    <!-- Timeline Card -->
                    <div class="ims-staff-card">
                        <h3 class="ims-staff-timeline-title">Timeline</h3>
                        <div class="ims-staff-timeline-list">
                            <div class="ims-staff-timeline-item">
                                <span>Submitted</span>
                                <span>10 Jul 2025</span>
                            </div>
                            <div class="ims-staff-timeline-item">
                                <span>Concept Development</span>
                                <span>14 Jul 2025</span>
                            </div>
                            <div class="ims-staff-timeline-item ims-staff-timeline-last">
                                <span>Last Updated</span>
                                <span>14 Jul 2025</span>
                            </div>
                        </div>
                    </div>
                </div>
