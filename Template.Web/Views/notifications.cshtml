@page
@model NotificationsModel
@{
    ViewData["Title"] = "Notifications - Innovation Management System";
}

<body class="ims-staff-dashboard">
    <!-- Sidebar -->
    <aside class="ims-staff-sidebar">
        <div class="ims-staff-sidebar-brand">
            <div class="ims-staff-brand-logo"><img src="~/boulogo.ico" alt="BOU"></div>
            <div class="ims-staff-brand-text">Bank of Uganda<span>Innovation Management</span></div>
        </div>
        <ul class="ims-staff-sidebar-nav">
            <li><a asp-page="/Staff/Dashboard"><span class="ims-staff-nav-icon"><i data-lucide="layout-dashboard" style="width:18px;height:18px;"></i></span><span>Dashboard</span></a></li>
            <li><a asp-page="/Staff/SubmitIdea"><span class="ims-staff-nav-icon"><i data-lucide="plus" style="width:18px;height:18px;"></i></span><span>Submit Idea</span></a></li>
            <li><a asp-page="/Staff/MyIdeas"><span class="ims-staff-nav-icon"><i data-lucide="list" style="width:18px;height:18px;"></i></span><span>My Ideas</span></a></li>
            <li><a asp-page="/Staff/Notifications" class="ims-staff-nav-active"><span class="ims-staff-nav-icon"><i data-lucide="mail" style="width:18px;height:18px;"></i></span><span>Notifications</span></a></li>
            <li><a asp-page="/Staff/Resources"><span class="ims-staff-nav-icon"><i data-lucide="book-open" style="width:18px;height:18px;"></i></span><span>Resources</span></a></li>
            <li><a asp-page="/Staff/Profile"><span class="ims-staff-nav-icon"><i data-lucide="user" style="width:18px;height:18px;"></i></span><span>Profile</span></a></li>
        </ul>
        <div class="ims-staff-sidebar-footer">BOU Innovation System v1.0</div>
    </aside>

    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
        <!-- Header -->
        <header class="ims-staff-top-header">
            <div class="ims-staff-header-left">
                <h2>Notifications</h2>
            </div>
            <div class="ims-staff-header-right">
                <button class="ims-staff-notification-btn">
                    <i data-lucide="bell" style="width:20px;height:20px;"></i>
                    @if (Model.UnreadCount > 0)
                    {
                        <span class="ims-staff-badge-dot"></span>
                    }
                </button>
                <div class="ims-staff-user-profile">
                    <div class="ims-staff-avatar">@User.Identity.Name?.Substring(0, 1)</div>
                    <span class="ims-staff-user-name">@User.Identity.Name</span>
                </div>
                <button class="ims-staff-logout-btn">Log out</button>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <div class="ims-staff-card">
                <!-- Tabs -->
                <div class="ims-staff-notification-tabs">
                    <a asp-page="/Staff/Notifications" asp-route-filter="all" class="ims-staff-tab @(Model.Filter == "all" ? "ims-staff-tab-active" : "")">All</a>
                    <a asp-page="/Staff/Notifications" asp-route-filter="unread" class="ims-staff-tab @(Model.Filter == "unread" ? "ims-staff-tab-active" : "")">
                        Unread
                        @if (Model.UnreadCount > 0)
                        {
                            <span class="ims-staff-tab-badge">@Model.UnreadCount</span>
                        }
                    </a>
                    <a asp-page="/Staff/Notifications" asp-route-filter="read" class="ims-staff-tab @(Model.Filter == "read" ? "ims-staff-tab-active" : "")">Read</a>
                    @if (Model.UnreadCount > 0)
                    {
                        <button class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-secondary ims-staff-mark-all-read" asp-page-handler="MarkAllRead">Mark All as Read</button>
                    }
                </div>

                <!-- Notification Items -->
                @if (Model.Notifications.Any())
                {
                    @foreach (var notification in Model.Notifications)
                    {
                        <div class="ims-staff-notification-item @(notification.IsUnread ? "ims-staff-notification-unread" : "")">
                            <div class="ims-staff-notif-icon">
                                <i data-lucide="@notification.Icon" style="width:18px;height:18px;"></i>
                            </div>
                            <div class="ims-staff-notif-content">
                                <div class="ims-staff-notif-title">@notification.Title</div>
                                <div class="ims-staff-notif-desc">@notification.Description</div>
                                <div class="ims-staff-notif-time">@notification.TimeAgo</div>
                            </div>
                            @if (notification.IsUnread)
                            {
                                <div class="ims-staff-unread-dot"></div>
                                <button class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-secondary ims-staff-mark-read-btn" asp-page-handler="MarkRead" asp-route-id="@notification.Id">Mark as read</button>
                            }
                        </div>
                    }

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <div class="ims-staff-pagination">
                            @if (Model.CurrentPage > 1)
                            {
                                <a asp-page="/Staff/Notifications" asp-route-filter="@Model.Filter" asp-route-page="@(Model.CurrentPage - 1)" class="ims-staff-pagination-link">&laquo; Previous</a>
                            }
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <a asp-page="/Staff/Notifications" asp-route-filter="@Model.Filter" asp-route-page="@i" class="ims-staff-pagination-link @(i == Model.CurrentPage ? "ims-staff-pagination-active" : "")">@i</a>
                            }
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a asp-page="/Staff/Notifications" asp-route-filter="@Model.Filter" asp-route-page="@(Model.CurrentPage + 1)" class="ims-staff-pagination-link">Next &raquo;</a>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="ims-staff-empty-state">
                        <i data-lucide="bell-off" style="width:48px;height:48px;color:#ccc;"></i>
                        <h3>No notifications</h3>
                        <p>You're all caught up! Check back later for updates.</p>
                    </div>
                }
            </div>
        </main>
    </div>

    @section Scripts {
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            lucide.createIcons();
        </script>
    }
</body>