@page
@model ResourcesModel
@{
    ViewData["Title"] = "Resources - Innovation Management System";
}

<body class="ims-staff-dashboard">
    <!-- Sidebar -->
    <aside class="ims-staff-sidebar">
        <div class="ims-staff-sidebar-brand">
            <div class="ims-staff-brand-logo"><img src="~/boulogo.ico" alt="BOU"></div>
            <div class="ims-staff-brand-text">Bank of Uganda<span>Innovation Management</span></div>
        </div>
        <ul class="ims-staff-sidebar-nav">
            <li><a asp-page="/Staff/Dashboard"><span class="ims-staff-nav-icon"><i data-lucide="layout-dashboard" style="width:18px;height:18px;"></i></span><span>Dashboard</span></a></li>
            <li><a asp-page="/Staff/SubmitIdea"><span class="ims-staff-nav-icon"><i data-lucide="plus" style="width:18px;height:18px;"></i></span><span>Submit Idea</span></a></li>
            <li><a asp-page="/Staff/MyIdeas"><span class="ims-staff-nav-icon"><i data-lucide="list" style="width:18px;height:18px;"></i></span><span>My Ideas</span></a></li>
            <li><a asp-page="/Staff/Notifications"><span class="ims-staff-nav-icon"><i data-lucide="mail" style="width:18px;height:18px;"></i></span><span>Notifications</span></a></li>
            <li><a asp-page="/Staff/Resources" class="ims-staff-nav-active"><span class="ims-staff-nav-icon"><i data-lucide="book-open" style="width:18px;height:18px;"></i></span><span>Resources</span></a></li>
            <li><a asp-page="/Staff/Profile"><span class="ims-staff-nav-icon"><i data-lucide="user" style="width:18px;height:18px;"></i></span><span>Profile</span></a></li>
        </ul>
        <div class="ims-staff-sidebar-footer">BOU Innovation System v1.0</div>
    </aside>

    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
        <!-- Header -->
        <header class="ims-staff-top-header">
            <div class="ims-staff-header-left">
                <h2>Resources Library</h2>
            </div>
            <div class="ims-staff-header-right">
                <button class="ims-staff-notification-btn"><i data-lucide="bell" style="width:20px;height:20px;"></i><span class="ims-staff-badge-dot"></span></button>
                <div class="ims-staff-user-profile">
                    <div class="ims-staff-avatar">@User.Identity.Name?.Substring(0, 1)</div>
                    <span class="ims-staff-user-name">@User.Identity.Name</span>
                </div>
                <button class="ims-staff-logout-btn">Log out</button>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <!-- Filters Bar -->
            <div class="ims-staff-filters-bar">
                <input type="text" class="ims-staff-form-control ims-staff-search-input" placeholder="Search resources..." asp-for="SearchTerm">
                <select class="ims-staff-form-control" asp-for="CategoryFilter">
                    <option value="">All Categories</option>
                    <option value="Innovation Guidelines">Innovation Guidelines</option>
                    <option value="Templates">Templates</option>
                    <option value="Policies">Policies</option>
                    <option value="Training Materials">Training Materials</option>
                </select>
                <button class="ims-staff-btn ims-staff-btn-primary ims-staff-btn-sm" asp-page-handler="ApplyFilters">Apply</button>
            </div>

            <!-- Resources Grid -->
            @if (Model.Resources.Any())
            {
                <div class="ims-staff-resource-grid">
                    @foreach (var resource in Model.Resources)
                    {
                        <div class="ims-staff-resource-card">
                            <div class="ims-staff-doc-icon">
                                <i data-lucide="@resource.Icon" style="width:24px;height:24px;"></i>
                            </div>
                            <h4 class="ims-staff-resource-title">@resource.Title</h4>
                            <p class="ims-staff-resource-description">@resource.Description</p>
                            <div class="ims-staff-resource-meta">Uploaded: @resource.UploadedDate.ToString("dd MMM yyyy")</div>
                            <div class="ims-staff-resource-actions">
                                <a asp-page-handler="View" asp-route-id="@resource.Id" class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-primary">View</a>
                                <a asp-page-handler="Download" asp-route-id="@resource.Id" class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-secondary">Download</a>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="ims-staff-pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-page="/Staff/Resources" asp-route-page="@(Model.CurrentPage - 1)" class="ims-staff-pagination-link">&laquo; Previous</a>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-page="/Staff/Resources" asp-route-page="@i" class="ims-staff-pagination-link @(i == Model.CurrentPage ? "ims-staff-pagination-active" : "")">@i</a>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-page="/Staff/Resources" asp-route-page="@(Model.CurrentPage + 1)" class="ims-staff-pagination-link">Next &raquo;</a>
                        }
                    </div>
                }
            }
            else
            {
                <div class="ims-staff-empty-state">
                    <i data-lucide="book-open" style="width:48px;height:48px;color:#ccc;"></i>
                    <h3>No resources found</h3>
                    <p>Try adjusting your search or filter criteria.</p>
                </div>
            }
        </main>
    </div>

    @section Scripts {
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            lucide.createIcons();
        </script>
    }
</body>