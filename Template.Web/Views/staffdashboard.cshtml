<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Dashboard - Innovation Management System</title>
    <link rel="icon" type="image/x-icon" href="../../boulogo.ico">
    <link rel="stylesheet" href="../../css/styles.css">
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="ims-staff-dashboard">
    <!-- Sidebar -->
    <aside class="ims-staff-sidebar">
        <div class="ims-staff-sidebar-brand">
            <div class="ims-staff-brand-logo"><img src="../../boulogo.ico" alt="BOU"></div>
            <div class="ims-staff-brand-text">Bank of Uganda<span>Innovation Management</span></div>
        </div>
        <ul class="ims-staff-sidebar-nav">
            <li><a href="dashboard.html" class="ims-staff-nav-active"><span class="ims-staff-nav-icon"><i data-lucide="layout-dashboard" style="width:18px;height:18px;"></i></span><span>Dashboard</span></a></li>
            <li><a href="submit-idea.html"><span class="ims-staff-nav-icon"><i data-lucide="plus" style="width:18px;height:18px;"></i></span><span>Submit Idea</span></a></li>
            <li><a href="my-ideas.html"><span class="ims-staff-nav-icon"><i data-lucide="list" style="width:18px;height:18px;"></i></span><span>My Ideas</span></a></li>
            <li><a href="notifications.html"><span class="ims-staff-nav-icon"><i data-lucide="mail" style="width:18px;height:18px;"></i></span><span>Notifications</span></a></li>
            <li><a href="resources.html"><span class="ims-staff-nav-icon"><i data-lucide="book-open" style="width:18px;height:18px;"></i></span><span>Resources</span></a></li>
            <li><a href="#"><span class="ims-staff-nav-icon"><i data-lucide="user" style="width:18px;height:18px;"></i></span><span>Profile</span></a></li>
        </ul>
        <div class="ims-staff-sidebar-footer">BOU Innovation System v1.0</div>
    </aside>

    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
        <!-- Header -->
        <header class="ims-staff-top-header">
            <div class="ims-staff-header-left">
                <h2>Dashboard</h2>
            </div>
            <div class="ims-staff-header-right">
                <button class="ims-staff-notification-btn"><i data-lucide="bell" style="width:20px;height:20px;"></i><span class="ims-staff-badge-dot"></span></button>
                <div class="ims-staff-user-profile">
                    <div class="ims-staff-avatar">B</div>
                    <span class="ims-staff-user-name">Brian</span>
                </div>
                <button class="ims-staff-logout-btn">Log out</button>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <!-- Welcome Bar -->
            <div class="ims-staff-welcome-bar">
                <h1>Welcome, Brian</h1>
                <p>Track and manage your innovation submissions</p>
            </div>

            <!-- Summary Cards -->
            <div class="ims-staff-summary-cards">
                <div class="ims-staff-summary-card">
                    <div class="ims-staff-card-label">Total Ideas Submitted</div>
                    <div class="ims-staff-card-value">12</div>
                    <div class="ims-staff-card-sub">All time</div>
                </div>
                <div class="ims-staff-summary-card">
                    <div class="ims-staff-card-label">Ideas Under Review</div>
                    <div class="ims-staff-card-value">4</div>
                    <div class="ims-staff-card-sub">Awaiting feedback</div>
                </div>
                <div class="ims-staff-summary-card">
                    <div class="ims-staff-card-label">Approved Ideas</div>
                    <div class="ims-staff-card-value">6</div>
                    <div class="ims-staff-card-sub">Ready for next stage</div>
                </div>
                <div class="ims-staff-summary-card">
                    <div class="ims-staff-card-label">Completed Innovations</div>
                    <div class="ims-staff-card-value">2</div>
                    <div class="ims-staff-card-sub">Successfully deployed</div>
                </div>
            </div>

            <!-- Two Column Grid -->
            <div class="ims-staff-two-col-grid">
                <!-- Recent Submissions -->
                <div class="ims-staff-card">
                    <div class="ims-staff-section-header">
                        <h3>Recent Submissions</h3>
                    </div>
                    <div class="ims-staff-table-container">
                        <table class="ims-staff-data-table">
                            <thead>
                                <tr>
                                    <th>Idea Title</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Digital Currency Wallet</td>
                                    <td>FinTech</td>
                                    <td><span class="ims-staff-badge ims-staff-badge-under-review">Under Review</span></td>
                                    <td>10 Jul 2025</td>
                                </tr>
                                <tr>
                                    <td>Automated Loan Disbursement</td>
                                    <td>Process</td>
                                    <td><span class="ims-staff-badge ims-staff-badge-approved">Approved</span></td>
                                    <td>28 Jun 2025</td>
                                </tr>
                                <tr>
                                    <td>Fraud Detection AI</td>
                                    <td>Technology</td>
                                    <td><span class="ims-staff-badge ims-staff-badge-submitted">Submitted</span></td>
                                    <td>15 Jun 2025</td>
                                </tr>
                                <tr>
                                    <td>Mobile Banking Lite</td>
                                    <td>Product</td>
                                    <td><span class="ims-staff-badge ims-staff-badge-declined">Declined</span></td>
                                    <td>02 Jun 2025</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Recent Notifications -->
                <div class="ims-staff-card">
                    <div class="ims-staff-section-header">
                        <h3>Recent Notifications</h3>
                    </div>
                    <div class="ims-staff-notification-item">
                        <div class="ims-staff-notif-icon"><i data-lucide="mail" style="width:18px;height:18px;"></i></div>
                        <div class="ims-staff-notif-content">
                            <div class="ims-staff-notif-title">Idea moved to Concept Development</div>
                            <div class="ims-staff-notif-desc">Your idea "Digital Currency Wallet" has progressed</div>
                            <div class="ims-staff-notif-time">2 hours ago</div>
                        </div>
                        <div class="ims-staff-unread-dot"></div>
                    </div>
                    <div class="ims-staff-notification-item">
                        <div class="ims-staff-notif-icon"><i data-lucide="alert-triangle" style="width:18px;height:18px;"></i></div>
                        <div class="ims-staff-notif-content">
                            <div class="ims-staff-notif-title">Additional information requested</div>
                            <div class="ims-staff-notif-desc">Innovation team needs more details on your submission</div>
                            <div class="ims-staff-notif-time">1 day ago</div>
                        </div>
                    </div>
                    <div class="ims-staff-notification-item">
                        <div class="ims-staff-notif-icon"><i data-lucide="check-circle" style="width:18px;height:18px;"></i></div>
                        <div class="ims-staff-notif-content">
                            <div class="ims-staff-notif-title">Submission approved</div>
                            <div class="ims-staff-notif-desc">"Automated Loan Disbursement" has been approved</div>
                            <div class="ims-staff-notif-time">3 days ago</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Action Button -->
            <button class="ims-staff-btn ims-staff-btn-primary ims-staff-quick-action-btn" style="width:100%;padding:14px;font-size:15px;">
                <i data-lucide="plus" style="width:16px;height:16px;"></i> Submit New Idea
            </button>
        </main>
    </div>

    <!-- Scripts -->
    <script src="../../services/ideaService.js"></script>
    <script src="../../services/userService.js"></script>
    <script src="../../services/notificationService.js"></script>
    <script src="../../services/resourceService.js"></script>
    <script src="../../services/categoryService.js"></script>
    <script src="../../services/activityService.js"></script>
    <script src="../../utils/toast.js"></script>
    <script src="../../utils/search.js"></script>
    <script src="../../utils/sort.js"></script>
    <script src="../../utils/filter.js"></script>
    <script src="../../utils/pagination.js"></script>
    <script src="../../utils/table.js"></script>
    <script src="../../utils/modal.js"></script>
    <script src="../../js/auth.js"></script>
    <script src="../../js/app.js"></script>
    <script src="../../js/dashboards.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>