@page
@model SubmittedIdeasModel
@{
    ViewData["Title"] = "Submitted Ideas - Innovation Management System";
}

<body class="ims-staff-dashboard">
    <!-- Sidebar -->
    <aside class="ims-staff-sidebar">
        <div class="ims-staff-sidebar-brand">
            <div class="ims-staff-brand-logo"><img src="~/boulogo.ico" alt="BOU"></div>
            <div class="ims-staff-brand-text">Bank of Uganda<span>Innovation Management</span></div>
        </div>
        <ul class="ims-staff-sidebar-nav">
            <li><a asp-page="/Innovation/Dashboard"><span class="ims-staff-nav-icon"><i data-lucide="layout-dashboard" style="width:18px;height:18px;"></i></span><span>Dashboard</span></a></li>
            <li><a asp-page="/Innovation/SubmittedIdeas" class="ims-staff-nav-active"><span class="ims-staff-nav-icon"><i data-lucide="list" style="width:18px;height:18px;"></i></span><span>Submitted Ideas</span></a></li>
            <li><a asp-page="/Innovation/Categories"><span class="ims-staff-nav-icon"><i data-lucide="folder-tree" style="width:18px;height:18px;"></i></span><span>Categories</span></a></li>
            <li><a asp-page="/Staff/Resources"><span class="ims-staff-nav-icon"><i data-lucide="book-open" style="width:18px;height:18px;"></i></span><span>Resources</span></a></li>
            <li><a asp-page="/Innovation/Reports"><span class="ims-staff-nav-icon"><i data-lucide="bar-chart-3" style="width:18px;height:18px;"></i></span><span>Reports</span></a></li>
            <li><a asp-page="/Innovation/Permissions"><span class="ims-staff-nav-icon"><i data-lucide="shield" style="width:18px;height:18px;"></i></span><span>Permissions</span></a></li>
        </ul>
        <div class="ims-staff-sidebar-footer">BOU Innovation System v1.0</div>
    </aside>

    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
        <!-- Header -->
        <header class="ims-staff-top-header">
            <div class="ims-staff-header-left">
                <h2>Submitted Ideas</h2>
            </div>
            <div class="ims-staff-header-right">
                <button class="ims-staff-notification-btn"><i data-lucide="bell" style="width:20px;height:20px;"></i><span class="ims-staff-badge-dot"></span></button>
                <div class="ims-staff-user-profile">
                    <div class="ims-staff-avatar">@User.Identity.Name?.Substring(0, 1)</div>
                    <span class="ims-staff-user-name">@User.Identity.Name</span>
                </div>
                <button class="ims-staff-logout-btn">Log out</button>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <!-- Filters Bar -->
            <div class="ims-staff-filters-bar">
                <input type="text" class="ims-staff-form-control ims-staff-search-input" placeholder="Search by title or submitter..." asp-for="SearchTerm">
                <select class="ims-staff-form-control" asp-for="StatusFilter">
                    <option value="">All Statuses</option>
                    <option value="Submitted">Submitted</option>
                    <option value="Under Review">Under Review</option>
                    <option value="Pending Information">Pending Information</option>
                    <option value="Approved">Approved</option>
                    <option value="Declined">Declined</option>
                </select>
                <select class="ims-staff-form-control" asp-for="CategoryFilter">
                    <option value="">All Categories</option>
                    <option value="FinTech">FinTech</option>
                    <option value="Process Improvement">Process Improvement</option>
                    <option value="Technology">Technology</option>
                    <option value="Product Innovation">Product Innovation</option>
                    <option value="Customer Experience">Customer Experience</option>
                </select>
                <select class="ims-staff-form-control" asp-for="DepartmentFilter">
                    <option value="">All Departments</option>
                    <option value="Information Technology">Information Technology</option>
                    <option value="Finance">Finance</option>
                    <option value="Operations">Operations</option>
                    <option value="Risk Management">Risk Management</option>
                    <option value="Human Resources">Human Resources</option>
                    <option value="Legal">Legal</option>
                </select>
                <input type="date" class="ims-staff-form-control" asp-for="DateFrom" style="min-width:auto;">
                <button class="ims-staff-btn ims-staff-btn-primary ims-staff-btn-sm" asp-page-handler="ApplyFilters">Apply</button>
                <button class="ims-staff-btn ims-staff-btn-secondary ims-staff-btn-sm" asp-page-handler="ClearFilters">Clear</button>
            </div>

            <!-- Ideas Table -->
            <div class="ims-staff-card ims-staff-table-card">
                <div class="ims-staff-table-container">
                    <table class="ims-staff-data-table">
                        <thead>
                            <tr>
                                <th>Idea Title</th>
                                <th>Submitter</th>
                                <th>Department</th>
                                <th>Category</th>
                                <th>Stage</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var idea in Model.Ideas)
                            {
                                <tr>
                                    <td><strong>@idea.Title</strong></td>
                                    <td>@idea.Submitter</td>
                                    <td>@idea.Department</td>
                                    <td>@idea.Category</td>
                                    <td>
                                        <span class="ims-staff-badge ims-staff-badge-@idea.Stage.Replace(" ", "-").ToLower()">
                                            @idea.Stage
                                        </span>
                                    </td>
                                    <td>
                                        <span class="ims-staff-badge ims-staff-badge-@idea.Status.Replace(" ", "-").ToLower()">
                                            @idea.Status
                                        </span>
                                    </td>
                                    <td>@idea.SubmittedDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <a asp-page="/Innovation/ReviewIdea" asp-route-id="@idea.Id" class="ims-staff-btn ims-staff-btn-sm @(idea.NeedsReview ? "ims-staff-btn-primary" : "ims-staff-btn-secondary")">
                                            @(idea.NeedsReview ? "Review" : "View Review")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="ims-staff-pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-page="/Innovation/SubmittedIdeas" asp-route-page="@(Model.CurrentPage - 1)" class="ims-staff-pagination-link">&laquo; Previous</a>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-page="/Innovation/SubmittedIdeas" asp-route-page="@i" class="ims-staff-pagination-link @(i == Model.CurrentPage ? "ims-staff-pagination-active" : "")">@i</a>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-page="/Innovation/SubmittedIdeas" asp-route-page="@(Model.CurrentPage + 1)" class="ims-staff-pagination-link">Next &raquo;</a>
                        }
                    </div>
                }
            </div>
        </main>
    </div>

    @section Scripts {
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            lucide.createIcons();
        </script>
    }
</body>