@page
@model UsersModel
@{
    ViewData["Title"] = "User Management - Innovation Management System";
}

<body class="ims-staff-dashboard">
    
    <!-- Main Content -->
    <div class="ims-staff-main-wrapper">
    
        <!-- Main Content Area -->
        <main class="ims-staff-main-content">
            <!-- Toolbar -->
            <div class="ims-staff-toolbar">
                <div class="ims-staff-filters-bar" style="margin-bottom:0;flex:1;">
                    <input type="text" class="ims-staff-form-control ims-staff-search-input" placeholder="Search users..." asp-for="SearchTerm">
                    <select class="ims-staff-form-control" asp-for="RoleFilter" style="min-width:150px;">
                        <option value="">All Roles</option>
                        <option value="Admin">Admin</option>
                        <option value="Innovation Manager">Innovation Manager</option>
                        <option value="Innovation Officer">Innovation Officer</option>
                        <option value="Staff">Staff</option>
                    </select>
                    <select class="ims-staff-form-control" asp-for="StatusFilter" style="min-width:150px;">
                        <option value="">All Statuses</option>
                        <option value="Active">Active</option>
                        <option value="Locked">Locked</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                    <button class="ims-staff-btn ims-staff-btn-primary ims-staff-btn-sm" asp-page-handler="ApplyFilters">Apply</button>
                </div>
                <button class="ims-staff-btn ims-staff-btn-primary ims-staff-create-user-btn" onclick="openCreateUserModal()">
                    <i data-lucide="plus" style="width:16px;height:16px;"></i> Create User
                </button>
            </div>

            <!-- Users Table -->
            <div class="ims-staff-card ims-staff-table-card">
                <div class="ims-staff-table-container">
                    <table class="ims-staff-data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Department</th>
                                <th>Role</th>
                                <th>Account Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>@user.Name</td>
                                    <td>@user.Email</td>
                                    <td>@user.Department</td>
                                    <td>@user.Role</td>
                                    <td>
                                        <span class="ims-staff-badge @(user.Status == "Active" ? "ims-staff-badge-success" : "ims-staff-badge-inactive")">
                                            @user.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="ims-staff-actions">
                                            @if (user.Status == "Locked")
                                            {
                                                <button class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-success" onclick="unlockUser(@user.Id)">Unlock</button>
                                            }
                                            else
                                            {
                                                <button class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-secondary" onclick="resetPassword(@user.Id)">Reset Password</button>
                                                <button class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-danger" onclick="lockUser(@user.Id)">Lock</button>
                                            }
                                            <button class="ims-staff-btn ims-staff-btn-sm ims-staff-btn-secondary" onclick="editUser(@user.Id)">Edit</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="ims-staff-pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-page="/Admin/Users" asp-route-page="@(Model.CurrentPage - 1)" class="ims-staff-pagination-link">&laquo; Previous</a>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-page="/Admin/Users" asp-route-page="@i" class="ims-staff-pagination-link @(i == Model.CurrentPage ? "ims-staff-pagination-active" : "")">@i</a>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-page="/Admin/Users" asp-route-page="@(Model.CurrentPage + 1)" class="ims-staff-pagination-link">Next &raquo;</a>
                        }
                    </div>
                }
            </div>
        </main>
    </div>

    <!-- Create User Modal -->
    <div class="ims-staff-modal" id="createUserModal" style="display:none;">
        <div class="ims-staff-modal-overlay" onclick="closeCreateUserModal()"></div>
        <div class="ims-staff-modal-content">
            <div class="ims-staff-modal-header">
                <h3>Create New User</h3>
                <button class="ims-staff-modal-close" onclick="closeCreateUserModal()">&times;</button>
            </div>
            <form method="post" asp-page-handler="CreateUser">
                <div class="ims-staff-modal-body">
                    <div class="ims-staff-form-group">
                        <label for="NewUserFullName">Full Name *</label>
                        <input type="text" id="NewUserFullName" class="ims-staff-form-control" asp-for="NewUser.FullName" placeholder="Enter full name">
                        <span asp-validation-for="NewUser.FullName" class="ims-staff-validation-feedback"></span>
                    </div>
                    <div class="ims-staff-form-group">
                        <label for="NewUserEmail">Email *</label>
                        <input type="email" id="NewUserEmail" class="ims-staff-form-control" asp-for="NewUser.Email" placeholder="Enter email address">
                        <span asp-validation-for="NewUser.Email" class="ims-staff-validation-feedback"></span>
                    </div>
                    <div class="ims-staff-form-group">
                        <label for="NewUserDepartment">Department *</label>
                        <select id="NewUserDepartment" class="ims-staff-form-control" asp-for="NewUser.Department">
                            <option value="">Select department</option>
                            <option value="Innovation Team">Innovation Team</option>
                            <option value="Information Technology">Information Technology</option>
                            <option value="Finance">Finance</option>
                            <option value="Operations">Operations</option>
                            <option value="Human Resources">Human Resources</option>
                            <option value="Legal">Legal</option>
                            <option value="Risk Management">Risk Management</option>
                            <option value="Research">Research</option>
                            <option value="Supervision">Supervision</option>
                        </select>
                        <span asp-validation-for="NewUser.Department" class="ims-staff-validation-feedback"></span>
                    </div>
                    <div class="ims-staff-form-group">
                        <label for="NewUserRole">Role *</label>
                        <select id="NewUserRole" class="ims-staff-form-control" asp-for="NewUser.Role">
                            <option value="">Select role</option>
                            <option value="Admin">Admin</option>
                            <option value="Innovation Manager">Innovation Manager</option>
                            <option value="Innovation Officer">Innovation Officer</option>
                            <option value="Staff">Staff</option>
                        </select>
                        <span asp-validation-for="NewUser.Role" class="ims-staff-validation-feedback"></span>
                    </div>
                    <div class="ims-staff-form-group">
                        <label for="NewUserPassword">Temporary Password *</label>
                        <input type="password" id="NewUserPassword" class="ims-staff-form-control" asp-for="NewUser.Password" placeholder="Enter temporary password">
                        <span asp-validation-for="NewUser.Password" class="ims-staff-validation-feedback"></span>
                        <p class="ims-staff-field-hint" style="margin-top:4px;">User will be prompted to change this on first login.</p>
                    </div>
                </div>
                <div class="ims-staff-modal-footer">
                    <button type="button" class="ims-staff-btn ims-staff-btn-secondary" onclick="closeCreateUserModal()">Cancel</button>
                    <button type="submit" class="ims-staff-btn ims-staff-btn-primary">Create User</button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            lucide.createIcons();

            function openCreateUserModal() {
                document.getElementById('createUserModal').style.display = 'block';
                document.body.style.overflow = 'hidden';
            }

            function closeCreateUserModal() {
                document.getElementById('createUserModal').style.display = 'none';
                document.body.style.overflow = 'auto';
            }

            function resetPassword(id) {
                if (confirm('Are you sure you want to reset the password for this user?')) {
                    window.location.href = `/Admin/Users?handler=ResetPassword&id=${id}`;
                }
            }

            function lockUser(id) {
                if (confirm('Are you sure you want to lock this user account?')) {
                    window.location.href = `/Admin/Users?handler=LockUser&id=${id}`;
                }
            }

            function unlockUser(id) {
                if (confirm('Are you sure you want to unlock this user account?')) {
                    window.location.href = `/Admin/Users?handler=UnlockUser&id=${id}`;
                }
            }

            function editUser(id) {
                window.location.href = `/Admin/Users?handler=Edit&id=${id}`;
            }

            // Close modal on ESC key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeCreateUserModal();
                }
            });

            // Close modal on outside click
            document.querySelector('.ims-staff-modal-overlay')?.addEventListener('click', closeCreateUserModal);
        </script>
    }
</body>