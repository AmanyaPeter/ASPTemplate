<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <targets>
    <target name="applicationFile" xsi:type="File"
            fileName="${basedir}/logs/application-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${aspnet-user-identity:whenEmpty=Unauthenticated}|${logger}|${message} ${exception:format=tostring}" />
    <target name="blackhole" xsi:type="Null" />
  </targets>

  <rules>
    <logger name="Microsoft.*" minlevel="Warn" writeTo="blackhole" final="true" />
    <logger name="System.*" minlevel="Warn" writeTo="blackhole" final="true" />
    <logger name="Template.*" minlevel="Info" writeTo="applicationFile" final="true" />
  </rules>
</nlog>
